{% schema %}
{
  "name": "Service List",
  "tag": "section",
  "class": "section-service-list",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "What we offer"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Services for<span> individuals</span> & families."
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Service Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Service Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Service Description",
          "default": "Service description text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service List",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Faith International / Debit Card",
            "description": "Virtual and physical card options where available."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Digital Wallet & Mobile Access",
            "description": "Manage your account, balances, and payments on iOS/Android."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Domestic & International Transfers",
            "description": "ACH, domestic wires, international wires, and internal transfers."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Check Cashing & Direct Deposit",
            "description": "Social Security, retirement, payroll, tax refunds, and recurring deposits."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Credit Repair & Financial Literacy",
            "description": "Credit builder education and resources to strengthen your profile."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Tax Preparation",
            "description": "Personal and family tax preparation services."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Mortgages & Refinance",
            "description": "Home financing and refinance support through applicable partners."
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "FaithSurance Term Life",
            "description": "Simple-application term life insurance pathway."
          }
        }
      ]
    }
  ]
}
{% endschema %}

