<div id="section-{{ section.id }}" class="elementor elementor-48 elementor-kit-9">
  <div class="elementor-element elementor-element-07852c4 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="07852c4" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-b3ea988 e-con-full e-flex e-con e-child elementor-invisible" data-id="b3ea988" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-0f46544 e-con-full e-flex e-con e-child" data-id="0f46544" data-element_type="container" data-e-type="container">
          {% if section.settings.badge_text != blank %}
            <div class="elementor-element elementor-element-5bbeb7f elementor-align-left elementor-widget elementor-widget-button" data-id="5bbeb7f" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
              <a class="elementor-button elementor-button-link elementor-size-sm" href="#">
                <span class="elementor-button-content-wrapper">
                  <span class="elementor-button-text">{{ section.settings.badge_text }}</span>
                </span>
              </a>
            </div>
          {% endif %}

          <div class="elementor-element elementor-element-89ad367 elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="89ad367" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
            <h2 class="elementor-heading-title elementor-size-default">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                Sharon<span> Butler</span>
              {% endif %}
            </h2>
          </div>

          {% if section.settings.text != blank %}
            <div class="elementor-element elementor-element-0d30403 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor" data-id="0d30403" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
              {{ section.settings.text }}
            </div>
          {% endif %}

          {% if section.settings.button_text != blank %}
            <div class="elementor-element elementor-element-9be8cbc elementor-align-left elementor-tablet-align-left elementor-mobile-align-left elementor-widget elementor-widget-button" data-id="9be8cbc" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
              <a class="elementor-button elementor-button-link elementor-size-sm" href="{{ section.settings.button_link | default: '/contact-us' }}">
                <span class="elementor-button-content-wrapper">
                  <span class="elementor-button-icon">
                    <svg aria-hidden="true" class="e-font-icon-svg e-fas-paper-plane" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M476 3.2L12.5 270.6c-18.1 10.4-15.8 35.6 2.2 43.2L121 358.4l287.3-253.2c5.5-4.9 13.3 2.6 8.6 8.3L176 407v80.5c0 23.6 28.5 32.9 42.5 15.8L282 426l124.6 52.2c14.2 6 30.4-2.9 33-18.2l72-432C515 7.8 493.3-6.8 476 3.2z"></path></svg>
                  </span>
                  <span class="elementor-button-text">{{ section.settings.button_text }}</span>
                </span>
              </a>
            </div>
          {% endif %}
        </div>

        <div class="elementor-element elementor-element-5fd58c5 e-con-full e-flex e-con e-child" data-id="5fd58c5" data-element_type="container" data-e-type="container">
          <div class="elementor-element elementor-element-b9ab439 elementor-widget elementor-widget-image" data-id="b9ab439" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img src="{{ section.settings.image | image_url: width: 400 }}" class="attachment-full size-full" alt="{{ section.settings.image.alt | default: 'Sharon Butler' | escape }}" loading="lazy" width="399" height="625">
            {% else %}
              <img src="{{ 'about-sharon-butler.webp' | asset_url }}" class="attachment-full size-full wp-image-9454" alt="Sharon Butler" loading="lazy" width="399" height="625">
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About - Co-Founder",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Co-Founder"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sharon<span> Butler</span>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Quote Text",
      "default": "The future of finance must serve people, not exploit them. FaithBanc™ is building global financial infrastructure grounded in integrity, innovation, and stewardship—designed to restore trust and create generational impact.”"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Co-Founder Image"
    }
  ],
  "presets": [
    {
      "name": "About - Co-Founder"
    }
  ]
}
{% endschema %}
