{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "section-faithbanc-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 180
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "Sign Up Button Text",
      "default": "Sign UP"
    },
    {
      "type": "url",
      "id": "signup_url",
      "label": "Sign Up Button URL"
    },
    {
      "type": "text",
      "id": "login_text",
      "label": "Login Button Text",
      "default": "Login"
    },
    {
      "type": "url",
      "id": "login_url",
      "label": "Login Button URL"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}

