<script>
  (function() {
    function initHeader() {
      var headerSection = document.getElementById('shopify-section-{{ section.id }}') || document.querySelector('.section-faithbanc-header');
      if (!headerSection) return;
      var toggleBtn = headerSection.querySelector('.elementor-menu-toggle');
      var dropdown = headerSection.querySelector('.elementor-nav-menu--dropdown');
      if (toggleBtn && dropdown) {
        toggleBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          var isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
          toggleBtn.classList.toggle('elementor-active', !isExpanded);
          dropdown.classList.toggle('is-active', !isExpanded);
          dropdown.setAttribute('aria-hidden', String(isExpanded));
          dropdown.style.display = !isExpanded ? 'block' : 'none';
        });

        document.addEventListener('click', function(e) {
          if (!headerSection.contains(e.target) && toggleBtn.classList.contains('elementor-active')) {
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.classList.remove('elementor-active');
            dropdown.classList.remove('is-active');
            dropdown.setAttribute('aria-hidden', 'true');
            dropdown.style.display = 'none';
          }
        });
      }

      {% if section.settings.enable_sticky %}
      var stickyEl = headerSection.querySelector('.elementor-sticky');
      if (stickyEl) {
        window.addEventListener('scroll', function() {
          if (window.scrollY > 10) {
            stickyEl.classList.add('elementor-sticky--effects');
          } else {
            stickyEl.classList.remove('elementor-sticky--effects');
          }
        }, { passive: true });
      }
      {% endif %}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeader);
    } else {
      initHeader();
    }
  })();
</script>
