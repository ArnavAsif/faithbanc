<div id="section-{{ section.id }}" class="elementor elementor-48 elementor-kit-9">
  <div class="elementor-element elementor-element-07852c4 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="07852c4" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-ba57d63 e-con-full e-flex e-con e-child elementor-invisible" data-id="ba57d63" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-35e13f0 e-con-full e-flex e-con e-child" data-id="35e13f0" data-element_type="container" data-e-type="container">
          <div class="elementor-element elementor-element-594c5aa elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="594c5aa" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
            <h2 class="elementor-heading-title elementor-size-default">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                <span>FaithBanc™</span> is the first ecosystem offering:
              {% endif %}
            </h2>
          </div>

          <div class="elementor-element elementor-element-9f34227 e-con-full e-flex e-con e-child" data-id="9f34227" data-element_type="container" data-e-type="container">
            <div class="elementor-element elementor-element-fc53248 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget-tablet__width-inherit elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="fc53248" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
              <ul class="elementor-icon-list-items">
                {% if section.blocks.size > 0 %}
                  {% for block in section.blocks limit: 3 %}
                    <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                      <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                    </li>
                  {% endfor %}
                {% else %}
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_1 | default: "- Digital banking &amp; microloans" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_2 | default: "- Blockchain wallet &amp; token" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_3 | default: "- Vocational hubs" }}</span>
                  </li>
                {% endif %}
              </ul>
            </div>

            <div class="elementor-element elementor-element-ad9e97b elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget-tablet__width-inherit elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="ad9e97b" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
              <ul class="elementor-icon-list-items">
                {% if section.blocks.size > 3 %}
                  {% for block in section.blocks offset: 3 %}
                    <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                      <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                    </li>
                  {% endfor %}
                {% else %}
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_1 | default: "- National food bank" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_2 | default: "- Homeless intervention" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_3 | default: "- Entrepreneurship network" }}</span>
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        </div>

        <div class="elementor-element elementor-element-f383598 e-con-full e-flex e-con e-child" data-id="f383598" data-element_type="container" data-e-type="container">
          <div class="elementor-element elementor-element-c88df3c elementor-widget elementor-widget-image" data-id="c88df3c" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img src="{{ section.settings.image | image_url: width: 1024 }}" class="attachment-full size-full" alt="{{ section.settings.image.alt | default: 'Ecosystem' | escape }}" loading="lazy" width="1024" height="887">
            {% else %}
              <img src="{{ 'about-ecosystem-offerings.webp' | asset_url }}" class="attachment-full size-full wp-image-8775" alt="Ecosystem" loading="lazy" width="1024" height="887">
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About - Ecosystem",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "<span>FaithBanc™</span> is the first ecosystem offering:"
    },
    {
      "type": "text",
      "id": "col1_item_1",
      "label": "Column 1 - Item 1",
      "default": "- Digital banking &amp; microloans"
    },
    {
      "type": "text",
      "id": "col1_item_2",
      "label": "Column 1 - Item 2",
      "default": "- Blockchain wallet &amp; token"
    },
    {
      "type": "text",
      "id": "col1_item_3",
      "label": "Column 1 - Item 3",
      "default": "- Vocational hubs"
    },
    {
      "type": "text",
      "id": "col2_item_1",
      "label": "Column 2 - Item 1",
      "default": "- National food bank"
    },
    {
      "type": "text",
      "id": "col2_item_2",
      "label": "Column 2 - Item 2",
      "default": "- Homeless intervention"
    },
    {
      "type": "text",
      "id": "col2_item_3",
      "label": "Column 2 - Item 3",
      "default": "- Entrepreneurship network"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bullet Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "- Item description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Ecosystem"
    }
  ]
}
{% endschema %}
