{% schema %}
{
  "name": "Islam Banking Details",
  "tag": "section",
  "class": "section-islam-banking",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc\u2122"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Islam Banking"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Strictly adhering to ethical financial standards and Shariah principles with zero hidden surcharges."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Find More"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Islam Banking Image"
    }
  ],
  "presets": [
    {
      "name": "Islam Banking Details"
    }
  ]
}
{% endschema %}

