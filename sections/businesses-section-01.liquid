{% schema %}
{
  "name": "Businesses Hero",
  "tag": "section",
  "class": "section-businesses-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "For Business Owners"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Better <span>Processing. </span>Better Margins."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Immediate savings, better processing options, rewards, and support for businesses that are often underserved or categorized as high risk."
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Get Processing Quote"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "Calculate My Savings"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Businesses Hero"
    }
  ]
}
{% endschema %}

