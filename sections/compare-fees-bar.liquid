    padding: 5px 18px;
  }
  .elementor-8440 .elementor-element.elementor-element-5a44586 .elementor-heading-title {
    font-size: 26px;
    line-height: 1.25em;
    letter-spacing: -0.8px;
  }
  .elementor-8440 .elementor-element.elementor-element-0892de5 {
    font-size: 14px;
    line-height: 22px;
    margin-bottom: 24px;
  }
  .fb-compare-table thead tr th {
    padding: 14px 10px;
    font-size: 13px;
  }
  .fb-compare-table tbody tr td {
    padding: 14px 10px;
    font-size: 13px;
  }
  .fb-compare-table tbody tr td:nth-child(5) {
    font-size: 15px;
  }
  .fb-table-note {
    font-size: 12px;
  }
}
</style>

