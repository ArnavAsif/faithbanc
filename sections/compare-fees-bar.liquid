}
.elementor-8440 .elementor-element.elementor-element-c9d54ae {
  width: 100%;
  max-width: 100%;
  margin: 0;
}

/* Compare Table Styling */
.fb-compare-table-wrap {
  width: 100%;
  max-width: 980px;
  margin: 0 auto;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.fb-compare-table-box {
  background: #FFFFFF;
  border: 1px solid #F3CFD7;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
}
.fb-compare-table {
  width: 100%;
  min-width: 660px;
  border-collapse: separate;
  border-spacing: 0;
  text-align: center;
  font-family: "Poppins", Sans-serif;
}
.fb-compare-table thead tr th {
  padding: 18px 16px;
  font-family: "Poppins", Sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  vertical-align: middle;
  border-right: 1px solid rgba(255, 255, 255, 0.15);
  border-bottom: none;
  letter-spacing: -0.2px;
}
.fb-compare-table thead tr th:first-child,
.fb-compare-table thead tr th:nth-child(2),
.fb-compare-table thead tr th:nth-child(3),
.fb-compare-table thead tr th:nth-child(4) {
  background-color: #840348;
}
.fb-compare-table thead tr th:nth-child(5) {
  background: linear-gradient(90deg, #D4145A 0%, #FF5B26 100%);
  border-right: none;
  font-weight: 700;
  font-size: 16px;
}

.fb-compare-table tbody tr td {
  padding: 18px 16px;
  font-family: "Poppins", Sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: #333333;
  text-align: center;
  vertical-align: middle;
  border-right: 1px solid #F0DFE3;
  border-bottom: 1px solid #F0DFE3;
  background-color: #FFFFFF;
}
.fb-compare-table tbody tr td:first-child {
  font-weight: 700;
  color: #111111;
  text-align: center;
}
.fb-compare-table .fb-volume-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  vertical-align: middle;
}
.fb-compare-table .fb-volume-icon svg {
  display: inline-block;
  vertical-align: middle;
}
.fb-compare-table tbody tr td:nth-child(2),
.fb-compare-table tbody tr td:nth-child(3),
.fb-compare-table tbody tr td:nth-child(4) {
  color: #444444;
}
.fb-compare-table tbody tr td:nth-child(5) {
  background-color: #FFF6F8;
  color: #D81159;
  font-weight: 800;
  font-size: 17px;
  border-right: none;
}
.fb-compare-table tbody tr:last-child td {
  border-bottom: none;
}

.fb-table-note {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  padding-left: 2px;
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
  color: #555555;
  line-height: 1.4;
  text-align: left;
}
.fb-table-note .fb-note-dot {
  width: 8px;
  height: 8px;
  background-color: #FF2A6D;
  border-radius: 50%;
  flex-shrink: 0;
  display: inline-block;
}

@media(max-width:1024px) {
