{% schema %}
{
  "name": "Compare Fees Bar",
  "tag": "section",
  "class": "section-compare-fees-bar",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Monthly Processing Fees"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Compare "
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Compare Fees Bar"
    }
  ]
}
{% endschema %}

<style>
