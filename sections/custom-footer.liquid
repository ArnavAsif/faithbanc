{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-faithbanc-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 180
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Footer Description",
      "default": "FaithBanc is a financial technology company committed to empowering purpose-driven businesses and community institutions with flat-fee processing and transparent services."
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 Heading",
      "default": "Programs"
    },
    {
      "type": "link_list",
      "id": "col1_menu",
      "label": "Column 1 Menu"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 Heading",
      "default": "Services"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 2 Menu"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer Menu (Alternative)"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 Heading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "646.258.5225"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "support@faithbanc.com"
    },
    {
      "type": "text",
      "id": "contact_website_text",
      "label": "Contact Website Text",
      "default": "www.FaithBanc.com"
    },
    {
      "type": "url",
      "id": "contact_website_url",
      "label": "Contact Website URL"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "\u00a9 2026 FaithBanc. All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}

