{% schema %}
{
  "name": "Purpose Driven Community",
  "tag": "section",
  "class": "section-purpose-driven",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc\u2122"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Financial Services for Purpose-Driven Communities ."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Comprehensive mobile wallet experiences built for ethical businesses and non-profit initiatives."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Find Out More"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Mockup Image"
    }
  ],
  "presets": [
    {
      "name": "Purpose Driven Community"
    }
  ]
}
{% endschema %}

<style>
.purple-glow-section {
  position: relative;
  overflow: hidden;
  background-color: #ffffff;
}
.purple-glow-section::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle at top right, rgba(173, 109, 244, 0.5), transparent 70%);
  filter: blur(80px);
  z-index: 0;
  pointer-events: none;
}
.purple-glow-section .elementor-container,
.purple-glow-section .e-con-inner {
  position: relative;
  z-index: 1;
}

/* Section Purpose Driven Communities Scoped Rules */
.elementor-8440 .elementor-element.elementor-element-db4060f {
  --display: flex;
  --min-height: 0px;
  --flex-direction: row;
  --container-widget-width: initial;
  --container-widget-height: 100%;
  --container-widget-flex-grow: 1;
  --container-widget-align-self: stretch;
  --flex-wrap-mobile: wrap;
  --padding-top: 80px;
  --padding-bottom: 80px;
  --padding-left: 0px;
  --padding-right: 0px;
}
.elementor-8440 .elementor-element.elementor-element-fe0cded {
  --display: flex;
  --justify-content: center;
}
.elementor-8440 .elementor-element.elementor-element-d0d940a .elementor-button {
  background-color: #FF572230;
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
  font-weight: 400;
  text-transform: uppercase;
  fill: var(--e-global-color-secondary);
  color: var(--e-global-color-secondary);
  border-radius: 45px 45px 45px 45px;
  padding: 10px 25px 10px 25px;
}
.elementor-8440 .elementor-element.elementor-element-660f529 {
  width: 100%;
  max-width: 100%;
  text-align: start;
}
.elementor-8440 .elementor-element.elementor-element-660f529 .elementor-heading-title {
  font-family: "Plus Jakarta Sans", Sans-serif;
  font-size: 36px;
  font-weight: 700;
  text-transform: capitalize;
  line-height: 49px;
  letter-spacing: -2.7px;
  color: var(--e-global-color-text);
}
.elementor-8440 .elementor-element.elementor-element-dc556e5 {
  width: var(--container-widget-width, 98%);
  max-width: 98%;
  --container-widget-width: 98%;
  --container-widget-flex-grow: 0;
  text-align: start;
  font-family: "Poppins", Sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 28px;
  letter-spacing: -0.5px;
  color: var(--e-global-color-91f3e4c);
}
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button {
  background-color: transparent;
  font-family: "Poppins", Sans-serif;
  font-size: 14px;
  font-weight: 300;
  text-transform: uppercase;
  font-style: normal;
  line-height: 14px;
  letter-spacing: -0.2px;
  fill: #FFFFFF;
  color: #FFFFFF;
  background-image: linear-gradient(148deg, #E42981 0%, #FEA035 100%);
  border-style: solid;
  border-width: 1px 1px 1px 1px;
  border-color: var(--e-global-color-832bc31);
  border-radius: 32px 32px 32px 32px;
  padding: 18px 35px 18px 35px;
}
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button:hover,
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button:focus {
  background-color: var(--e-global-color-3d786e9);
  color: var(--e-global-color-0587ab8);
}
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button-content-wrapper {
  flex-direction: row;
}
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button:hover svg,
.elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button:focus svg {
  fill: var(--e-global-color-0587ab8);
}
.elementor-8440 .elementor-element.elementor-element-245d8b7 {
  --display: flex;
  --justify-content: center;
}
.elementor-8440 .elementor-element.elementor-element-245d8b7.e-con {
  --order: 99999
    /* order end hack */
  ;
}
.elementor-8440 .elementor-element.elementor-element-07d1c64 {
  margin: 0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;
}
.elementor-8440 .elementor-element.elementor-element-07d1c64 img {
  width: 100%;
  border-radius: 8px 8px 8px 8px;
}

@media(max-width:1024px) {
  .elementor-8440 .elementor-element.elementor-element-db4060f {
    --min-height: 580px;
    --padding-top: 150px;
    --padding-bottom: 50px;
    --padding-left: 0px;
    --padding-right: 0px;
  }
  .elementor-8440 .elementor-element.elementor-element-660f529 {
    width: 100%;
    max-width: 100%;
  }
  .elementor-8440 .elementor-element.elementor-element-660f529 .elementor-heading-title {
    font-size: 32px;
    line-height: 1.3em;
  }
  .elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button {
    font-size: 15px;
    padding: 16px 35px 16px 35px;
  }
  .elementor-8440 .elementor-element.elementor-element-07d1c64 {
    margin: 0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;
  }
}

@media(max-width:767px) {
  .elementor-8440 .elementor-element.elementor-element-db4060f {
    --padding-top: 50px;
    --padding-bottom: 50px;
    --padding-left: 15px;
    --padding-right: 15px;
  }
  .elementor-8440 .elementor-element.elementor-element-d0d940a .elementor-button {
    font-size: 10px;
  }
  .elementor-8440 .elementor-element.elementor-element-660f529 {
    text-align: start;
  }
  .elementor-8440 .elementor-element.elementor-element-660f529 .elementor-heading-title {
    font-size: 23px;
    line-height: 1.3em;
    letter-spacing: -1.5px;
  }
  .elementor-8440 .elementor-element.elementor-element-c102221 .elementor-button {
    font-size: 12px;
    padding: 15px 15px 15px 15px;
  }
  .elementor-8440 .elementor-element.elementor-element-245d8b7.e-con {
    --order: -99999
      /* order start hack */
    ;
  }
  .elementor-8440 .elementor-element.elementor-element-07d1c64 {
    margin: 0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;
  }
  .elementor-8440 .elementor-element.elementor-element-07d1c64 img {
    width: 100%;
  }
}
</style>

<div class="elementor elementor-8440 elementor-kit-9">
<div class="elementor-element elementor-element-db4060f purple-glow-section e-flex e-con-boxed e-con e-parent e-lazyloaded"
			data-id="db4060f" data-element_type="container" data-e-type="container"
			data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
			<div class="e-con-inner">
				<div class="elementor-element elementor-element-fe0cded e-con-full e-flex e-con e-child"
					data-id="fe0cded" data-element_type="container" data-e-type="container">
					<div class="elementor-element elementor-element-d0d940a elementor-align-left elementor-widget elementor-widget-button"
						data-id="d0d940a" data-element_type="widget" data-e-type="widget"
						data-widget_type="button.default">
						<a class="elementor-button elementor-button-link elementor-size-sm" href="#">
							<span class="elementor-button-content-wrapper">
								<span class="elementor-button-text">{{ section.settings.badge_text | default: "FaithBanc™" }}</span>
							</span>
						</a>
					</div>
					<div class="elementor-element elementor-element-660f529 elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading"
						data-id="660f529" data-element_type="widget" data-e-type="widget"
						data-widget_type="heading.default">
						<h2 class="elementor-heading-title elementor-size-default">Financial Services for
							<span>Purpose-Driven Communities .</span>
						</h2>
					</div>
					<div class="elementor-element elementor-element-dc556e5 elementor-widget__width-initial elementor-widget elementor-widget-text-editor"
						data-id="dc556e5" data-element_type="widget" data-e-type="widget"
						data-widget_type="text-editor.default">
						Faith Banc is a nonprofit financial technology organization providing accessible digital
						financial tools to serve individuals, families, churches, and nonprofits

					</div>
					<div class="elementor-element elementor-element-c102221 elementor-align-left elementor-tablet-align-left elementor-mobile-align-left elementor-widget elementor-widget-button"
						data-id="c102221" data-element_type="widget" data-e-type="widget"
						data-widget_type="button.default">
						<a class="elementor-button elementor-button-link elementor-size-sm" href="/contact-us">
							<span class="elementor-button-content-wrapper">
								<span class="elementor-button-icon">
									<svg aria-hidden="true" class="e-font-icon-svg e-fas-paper-plane"
										viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
										<path
											d="M476 3.2L12.5 270.6c-18.1 10.4-15.8 35.6 2.2 43.2L121 358.4l287.3-253.2c5.5-4.9 13.3 2.6 8.6 8.3L176 407v80.5c0 23.6 28.5 32.9 42.5 15.8L282 426l124.6 52.2c14.2 6 30.4-2.9 33-18.2l72-432C515 7.8 493.3-6.8 476 3.2z">
										</path>
									</svg> </span>
								<span class="elementor-button-text">{{ section.settings.btn_text | default: "Find Out More" }}</span>
							</span>
						</a>
					</div>
				</div>
				<div class="elementor-element elementor-element-245d8b7 e-con-full e-flex e-con e-child"
					data-id="245d8b7" data-element_type="container" data-e-type="container">
					<div class="elementor-element elementor-element-07d1c64 elementor-widget elementor-widget-image"
						data-id="07d1c64" data-element_type="widget" data-e-type="widget"
						data-widget_type="image.default">
						{% if section.settings.image != blank %}
<img src="{{ section.settings.image | image_url: width: 1200 }}" class="attachment-full size-full" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
{% else %}
<img loading="lazy" decoding="async" width="1448" height="1086"
							src="https://faithbanc.com/wp-content/uploads/2026/05/ChatGPT-Image-May-19-2026-04_16_40-PM.png"
							class="attachment-full size-full wp-image-8561" alt=""
							srcset="https://faithbanc.com/wp-content/uploads/2026/05/ChatGPT-Image-May-19-2026-04_16_40-PM.png 1448w, https://faithbanc.com/wp-content/uploads/2026/05/ChatGPT-Image-May-19-2026-04_16_40-PM-300x225.png 300w, https://faithbanc.com/wp-content/uploads/2026/05/ChatGPT-Image-May-19-2026-04_16_40-PM-1024x768.png 1024w, https://faithbanc.com/wp-content/uploads/2026/05/ChatGPT-Image-May-19-2026-04_16_40-PM-768x576.png 768w"
							sizes="(max-width: 1448px) 100vw, 1448px">
{% endif %}
					</div>
				</div>
			</div>
		</div>
</div>
