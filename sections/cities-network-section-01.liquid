{% schema %}
{
  "name": "Cities Network Hero",
  "tag": "section",
  "class": "section-cities-network-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc™"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "FaithBanc™ Is <span>Building a </span>National Network of Faith-Powered Cities"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "FaithBanc™ delivers digital banking, community support, workforce training, food assistance, and silver-backed bartering across multiple cities—connected through one unified national platform."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Cities Network Hero"
    }
  ]
}
{% endschema %}

<style>
/* Cities Network Section 01 Scoped Rules */

.elementor-42 .elementor-element.elementor-element-32abcd8{width:100%;max-width:100%;text-align:start;}
.elementor-42 .elementor-element.elementor-element-32abcd8 .elementor-heading-title{font-family:"Plus Jakarta Sans", Sans-serif;font-size:44px;font-weight:600;text-transform:capitalize;line-height:55px;letter-spacing:-2.7px;color:var( --e-global-color-secondary );}
.elementor-42 .elementor-element.elementor-element-32abcd8{width:100%;max-width:100%;}
.elementor-42 .elementor-element.elementor-element-32abcd8 .elementor-heading-title{font-size:32px;line-height:1.3em;}
.elementor-42 .elementor-element.elementor-element-32abcd8{text-align:center;}
.elementor-42 .elementor-element.elementor-element-32abcd8 .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}
.gradient-text span{
    background: linear-gradient(135deg,#FF5722 0%,#FF3366 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.elementor-42 .elementor-element.elementor-element-6002a2e{text-align:end;}
.elementor-42 .elementor-element.elementor-element-6002a2e img{max-width:73%;}
.elementor-42 .elementor-element.elementor-element-6002a2e{margin:-54px 0px calc(var(--kit-widget-spacing, 0px) + -24px) 0px;}
.elementor-42 .elementor-element.elementor-element-6002a2e img{max-width:100%;}
.elementor-42 .elementor-element.elementor-element-e932968 .elementor-button{background-color:var( --e-global-color-0587ab8 );font-family:"Poppins", Sans-serif;font-size:13px;font-weight:500;text-transform:uppercase;fill:var( --e-global-color-66d3c96 );color:var( --e-global-color-66d3c96 );border-radius:45px 45px 45px 45px;padding:9px 25px 9px 25px;}
.elementor-42 .elementor-element.elementor-element-e932968.elementor-element{--align-self:flex-start;}
.elementor-42 .elementor-element.elementor-element-e932968.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-6e2f959{--display:flex;}
.elementor-42 .elementor-element.elementor-element-6e2f959.e-con{--order:-99999 /* order start hack */;}

.elementor-42 .elementor-element.elementor-element-d46fa69{--display:flex;--min-height:0px;--flex-direction:row;--container-widget-width:initial;--container-widget-height:100%;--container-widget-flex-grow:1;--container-widget-align-self:stretch;--flex-wrap-mobile:wrap;--padding-top:150px;--padding-bottom:100px;--padding-left:0px;--padding-right:0px;}
.elementor-42 .elementor-element.elementor-element-d46fa69:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-d46fa69 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-image:url("{{ 'cities-network-hero-bg.webp' | asset_url }}");background-position:center center;background-repeat:no-repeat;background-size:cover;}
.elementor-42 .elementor-element.elementor-element-d46fa69{--content-width:1200px;}
.elementor-42 .elementor-element.elementor-element-d46fa69{--padding-top:120px;--padding-bottom:80px;--padding-left:15px;--padding-right:15px;}
.elementor-42 .elementor-element.elementor-element-765d1a99{width:100%;max-width:100%;text-align:start;font-family:"Poppins", Sans-serif;font-size:16px;font-weight:400;line-height:29px;letter-spacing:-0.5px;color:var( --e-global-color-secondary );}
.elementor-42 .elementor-element.elementor-element-765d1a99.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-765d1a99{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
.elementor-42 .elementor-element.elementor-element-765d1a99{text-align:center;font-size:15px;}
.elementor-42 .elementor-element.elementor-element-052b269{--display:flex;--flex-direction:column;--container-widget-width:100%;--container-widget-height:initial;--container-widget-flex-grow:0;--container-widget-align-self:initial;--flex-wrap-mobile:wrap;--justify-content:center;}
.elementor-42 .elementor-element.elementor-element-052b269{--padding-top:0px;--padding-bottom:0px;--padding-left:0px;--padding-right:0px;}

@media(max-width:1024px){
  .elementor-42 .elementor-element.elementor-element-32abcd8{width:100%;max-width:100%;}
  .elementor-42 .elementor-element.elementor-element-32abcd8 .elementor-heading-title{font-size:32px;line-height:1.3em;}
  .elementor-42 .elementor-element.elementor-element-765d1a99{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
}
@media(min-width:768px){
  .elementor-42 .elementor-element.elementor-element-d46fa69{--content-width:1200px;}
}
@media(max-width:767px){
  .elementor-42 .elementor-element.elementor-element-d46fa69{--padding-top:120px;--padding-bottom:80px;--padding-left:15px;--padding-right:15px;}
  .elementor-42 .elementor-element.elementor-element-052b269{--padding-top:0px;--padding-bottom:0px;--padding-left:0px;--padding-right:0px;}
  .elementor-42 .elementor-element.elementor-element-e932968.elementor-element{--align-self:center;}
  .elementor-42 .elementor-element.elementor-element-32abcd8{text-align:center;}
  .elementor-42 .elementor-element.elementor-element-32abcd8 .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}
  .elementor-42 .elementor-element.elementor-element-765d1a99{text-align:center;font-size:15px;}
  .elementor-42 .elementor-element.elementor-element-6e2f959.e-con{--order:-99999 /* order start hack */;}
  .elementor-42 .elementor-element.elementor-element-6002a2e{margin:-54px 0px calc(var(--kit-widget-spacing, 0px) + -24px) 0px;}
  .elementor-42 .elementor-element.elementor-element-6002a2e img{max-width:100%;}
}
</style>

<div class="elementor elementor-42">
  <div class="elementor-element elementor-element-d46fa69 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="d46fa69" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}' {% if section.settings.bg_image != blank %}style="background-image: url('{{ section.settings.bg_image | image_url: width: 2560 }}');"{% endif %}>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-052b269 e-con-full e-flex e-con e-child" data-id="052b269" data-element_type="container" data-e-type="container">
        {% if section.settings.badge_text != blank %}
          <div class="elementor-element elementor-element-e932968 elementor-align-center elementor-widget elementor-widget-button" data-id="e932968" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
            <a class="elementor-button elementor-button-link elementor-size-sm" href="{{ section.settings.badge_url | default: '#' }}">
              <span class="elementor-button-content-wrapper">
                <span class="elementor-button-text">{{ section.settings.badge_text }}</span>
              </span>
            </a>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="elementor-element elementor-element-32abcd8 elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading animated fadeInUp" data-id="32abcd8" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="heading.default">
            <h1 class="elementor-heading-title elementor-size-default">
              {{ section.settings.heading }}
            </h1>
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="elementor-element elementor-element-765d1a99 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor animated fadeInUp" data-id="765d1a99" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="text-editor.default">
            <p>{{ section.settings.description }}</p>
          </div>
        {% endif %}
      </div>

      <div class="elementor-element elementor-element-6e2f959 e-con-full e-flex e-con e-child" data-id="6e2f959" data-element_type="container" data-e-type="container">
        <div class="elementor-element elementor-element-6002a2e elementor-widget elementor-widget-image animated fadeInRight" data-id="6002a2e" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInRight"}' data-widget_type="image.default">
          {% if section.settings.hero_image != blank %}
            <img decoding="async" width="1024" height="1024" src="{{ section.settings.hero_image | image_url: width: 1024 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="eager">
          {% else %}
            <img decoding="async" width="1024" height="1024" src="{{ 'cities-network-hero.webp' | asset_url }}" class="attachment-full size-full wp-image-8704" alt="{{ section.settings.heading | escape }}" loading="eager">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
