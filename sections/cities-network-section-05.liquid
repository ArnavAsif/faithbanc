{% schema %}
{
  "name": "Services Available",
  "tag": "section",
  "class": "section-cities-network-services",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "FaithBanc™ Services <span>Available</span> in Every City"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "All FaithBanc™ cities offer access to the same secure, scalable platform:"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "service_item",
      "name": "Service Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Text",
          "default": "Financial Services"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Available",
      "blocks": [
        { "type": "service_item", "settings": { "text": "Financial Services" } },
        { "type": "service_item", "settings": { "text": "Faith Wallet (Spend • Save • Give)" } },
        { "type": "service_item", "settings": { "text": "Faith Debit Card (Physical + Virtual)" } },
        { "type": "service_item", "settings": { "text": "Faith Dollar Digital Credits" } },
        { "type": "service_item", "settings": { "text": "Faith Token & Blockchain Wallet" } },
        { "type": "service_item", "settings": { "text": "Apple Pay / Google Pay" } },
        { "type": "service_item", "settings": { "text": "FDIC-backed partner banking" } },
        { "type": "service_item", "settings": { "text": "Family & Youth Banking" } },
        { "type": "service_item", "settings": { "text": "Teen accounts with parental controls" } },
        { "type": "service_item", "settings": { "text": "Allowance automation" } },
        { "type": "service_item", "settings": { "text": "Financial education & stewardship tools" } },
        { "type": "service_item", "settings": { "text": "Community & Economic Support" } },
        { "type": "service_item", "settings": { "text": "Workforce training & certifications" } },
        { "type": "service_item", "settings": { "text": "Food assistance networks" } },
        { "type": "service_item", "settings": { "text": "Homeless outreach support" } },
        { "type": "service_item", "settings": { "text": "FaithCredits silver-backed bartering marketplace" } },
        { "type": "service_item", "settings": { "text": "Church-led programs & grants" } }
      ]
    }
  ]
}
{% endschema %}

<style>
/* Cities Network Section 05 Scoped Rules */

.cities-sec-05-wrapper{
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.elementor-42 .elementor-element.elementor-element-2ec080b6{--display:flex;--flex-direction:column;--container-widget-width:100%;--container-widget-height:initial;--container-widget-flex-grow:0;--container-widget-align-self:initial;--flex-wrap-mobile:wrap;--gap:50px 50px;--row-gap:50px;--column-gap:50px;--padding-left:0px;--padding-right:0px;}
.elementor-42 .elementor-element.elementor-element-2ec080b6:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-2ec080b6 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FFFFFF;}

.elementor-42 .elementor-element.elementor-element-67f70032{--display:flex;--flex-direction:row;--container-widget-width:initial;--container-widget-height:100%;--container-widget-flex-grow:1;--container-widget-align-self:stretch;--flex-wrap-mobile:wrap;--gap:30px 30px;--row-gap:30px;--column-gap:30px;--overflow:hidden;border-style:solid;--border-style:solid;border-width:1px 1px 1px 1px;--border-top-width:1px;--border-right-width:1px;--border-bottom-width:1px;--border-left-width:1px;border-color:#CFCFCF75;--border-color:#CFCFCF75;border-radius:12px 12px 12px 12px;--padding-top:50px;--padding-bottom:50px;--padding-left:50px;--padding-right:50px;}
.elementor-42 .elementor-element.elementor-element-67f70032:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-67f70032 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FAFAFA;}

.elementor-42 .elementor-element.elementor-element-168bc931{--display:flex;--justify-content:center;--border-radius:15px 15px 15px 15px;}
.elementor-42 .elementor-element.elementor-element-168bc931.e-con{--order:-99999 /* order start hack */;}
.elementor-42 .elementor-element.elementor-element-168bc931{--min-height:208px;}

.elementor-42 .elementor-element.elementor-element-ea8af28{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}
.elementor-42 .elementor-element.elementor-element-ea8af28 img{width:76%;}

.elementor-42 .elementor-element.elementor-element-2986b2c{--display:flex;--justify-content:center;}
.elementor-42 .elementor-element.elementor-element-2986b2c.e-con{--order:-99999 /* order start hack */;}

.elementor-42 .elementor-element.elementor-element-33799d1b{width:var( --container-widget-width, 92% );max-width:92%;--container-widget-width:92%;--container-widget-flex-grow:0;text-align:start;}
.elementor-42 .elementor-element.elementor-element-33799d1b .elementor-heading-title{font-family:"Plus Jakarta Sans", Sans-serif;font-size:42px;font-weight:700;text-transform:capitalize;line-height:55px;letter-spacing:-2.7px;color:var( --e-global-color-text );}
.elementor-42 .elementor-element.elementor-element-33799d1b{width:100%;max-width:100%;}
.elementor-42 .elementor-element.elementor-element-33799d1b .elementor-heading-title{font-size:32px;line-height:1.3em;}
.elementor-42 .elementor-element.elementor-element-33799d1b{text-align:start;}
.elementor-42 .elementor-element.elementor-element-33799d1b .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}

.elementor-42 .elementor-element.elementor-element-2d73b661{width:100%;max-width:100%;text-align:start;font-family:"Poppins", Sans-serif;font-size:16px;font-weight:400;line-height:29px;letter-spacing:-0.5px;color:var( --e-global-color-secondary );}
.elementor-42 .elementor-element.elementor-element-2d73b661.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-2d73b661{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
.elementor-42 .elementor-element.elementor-element-2d73b661{text-align:start;font-size:15px;}

.elementor-42 .elementor-element.elementor-element-33b570ec{width:100%;max-width:100%;--e-icon-list-icon-size:16px;--icon-vertical-align:flex-start;--icon-vertical-offset:4px;}
.elementor-42 .elementor-element.elementor-element-33b570ec.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-33b570ec .elementor-icon-list-items:not(.elementor-inline-items) .elementor-icon-list-item:not(:last-child){padding-block-end:calc(5px/2);}
.elementor-42 .elementor-element.elementor-element-33b570ec .elementor-icon-list-items:not(.elementor-inline-items) .elementor-icon-list-item:not(:first-child){margin-block-start:calc(5px/2);}
.elementor-42 .elementor-element.elementor-element-33b570ec .elementor-icon-list-item > .elementor-icon-list-text{font-size:15px;font-weight:400;letter-spacing:-0.6px;color:var( --e-global-color-secondary );transition:color 0.3s;}
.elementor-42 .elementor-element.elementor-element-33b570ec{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}

@media(max-width:1024px){
  .elementor-42 .elementor-element.elementor-element-33799d1b{width:100%;max-width:100%;}
  .elementor-42 .elementor-element.elementor-element-33799d1b .elementor-heading-title{font-size:32px;line-height:1.3em;}
  .elementor-42 .elementor-element.elementor-element-2d73b661{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
  .elementor-42 .elementor-element.elementor-element-33b570ec{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
}
@media(max-width:767px){
  .cities-sec-05-wrapper{padding-left:15px;padding-right:15px;}
  .elementor-42 .elementor-element.elementor-element-67f70032{--gap:20px 20px;--row-gap:20px;--column-gap:20px;--padding-top:15px;--padding-bottom:15px;--padding-left:15px;--padding-right:15px;}
  .elementor-42 .elementor-element.elementor-element-168bc931{--min-height:208px;}
  .elementor-42 .elementor-element.elementor-element-168bc931.e-con{--order:-99999 /* order start hack */;}
  .elementor-42 .elementor-element.elementor-element-ea8af28{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}
  .elementor-42 .elementor-element.elementor-element-33799d1b{text-align:start;}
  .elementor-42 .elementor-element.elementor-element-33799d1b .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}
  .elementor-42 .elementor-element.elementor-element-2d73b661{text-align:start;font-size:15px;}
}
</style>

<div class="elementor elementor-42 cities-sec-05-wrapper">
  <div class="elementor-element elementor-element-2ec080b6 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="2ec080b6" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-67f70032 e-con-full e-flex e-con e-child animated fadeInUp" data-id="67f70032" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-168bc931 e-con-full e-flex e-con e-child" data-id="168bc931" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
          <div class="elementor-element elementor-element-ea8af28 elementor-widget elementor-widget-image" data-id="ea8af28" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img decoding="async" width="1024" height="1024" src="{{ section.settings.image | image_url: width: 1024 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% else %}
              <img decoding="async" width="1024" height="1024" src="{{ 'cities-network-objectives.webp' | asset_url }}" class="attachment-full size-full wp-image-8704" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% endif %}
          </div>
        </div>

        <div class="elementor-element elementor-element-2986b2c e-con-full e-flex e-con e-child" data-id="2986b2c" data-element_type="container" data-e-type="container">
          {% if section.settings.heading != blank %}
            <div class="elementor-element elementor-element-33799d1b elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="33799d1b" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
              <h2 class="elementor-heading-title elementor-size-default">
                {{ section.settings.heading }}
              </h2>
            </div>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="elementor-element elementor-element-2d73b661 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor" data-id="2d73b661" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="elementor-element elementor-element-33b570ec elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="33b570ec" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
            <ul class="elementor-icon-list-items">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                    <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
