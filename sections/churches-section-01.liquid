    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
