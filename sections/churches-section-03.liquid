        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% assign card_idx = forloop.index0 %}
            {% case card_idx %}
              {% when 0 %}
                {% assign card_id = "2a81661" %}
                {% assign img_id = "da91361" %}
                {% assign title_id = "f7cabf9" %}
                {% assign anim_name = "fadeInLeft" %}
                {% assign default_img_name = "churches-step-1.webp" %}
