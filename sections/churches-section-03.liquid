              <div class="elementor-element elementor-element-{{ img_id }} elementor-widget elementor-widget-image" data-id="{{ img_id }}" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}" width="65" height="65" class="attachment-full size-full" loading="lazy" decoding="async">
                {% else %}
                  <img src="{{ default_img_name | asset_url }}" alt="{{ block.settings.title | escape }}" width="65" height="65" class="attachment-full size-full" loading="lazy" decoding="async">
                {% endif %}
              </div>
              <div class="elementor-element elementor-element-{{ title_id }} elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget-mobile__width-auto elementor-widget elementor-widget-heading" data-id="{{ title_id }}" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
