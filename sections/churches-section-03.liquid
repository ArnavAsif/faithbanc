{% schema %}
{
  "name": "Churches Calls to Action",
  "tag": "section",
  "class": "section-churches-cta",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Three Calls to Action"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Where <span>would you </span>like to start?"
    }
  ],
  "blocks": [
    {
      "type": "cta_card",
      "name": "Action Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Icon / Image"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Become a Church Partner \u2192"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Churches Calls to Action",
      "blocks": [
        {
          "type": "cta_card",
          "settings": {
            "title": "Become a Church Partner \u2192"
          }
        },
        {
          "type": "cta_card",
          "settings": {
            "title": "Refer a Business \u2192"
          }
        },
        {
          "type": "cta_card",
          "settings": {
            "title": "Schedule Pastor Consultation \u2192"
          }
        }
      ]
    }
  ]
}
{% endschema %}

