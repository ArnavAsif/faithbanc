                {% assign card_id = "415d349" %}
                {% assign img_id = "ce9e797" %}
                {% assign title_id = "6ca43ef" %}
                {% assign anim_name = "fadeInUp" %}
                {% assign default_img_name = "churches-step-3.webp" %}
              {% else %}
                {% assign card_id = "card-" | append: forloop.index %}
                {% assign img_id = "img-" | append: forloop.index %}
                {% assign title_id = "title-" | append: forloop.index %}
                {% assign anim_name = "fadeInUp" %}
                {% assign default_img_name = "churches-step-1.webp" %}
            {% endcase %}

