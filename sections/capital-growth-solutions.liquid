{% schema %}
{
  "name": "Capital Growth Solutions",
  "tag": "section",
  "class": "section-capital-growth-solutions",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc\u2122 Capital"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Capital Built Around Business Growth"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Flexible funding designed to empower ambitious businesses with non-predatory growth capital."
    }
  ],
  "presets": [
    {
      "name": "Capital Growth Solutions",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Working Capital",
            "button_text": "Request Review"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Merchant Funding",
            "button_text": "Check Eligibility"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Equipment Financing",
            "button_text": "Finance Equipment"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Receivable Financing",
            "button_text": "Unlock Cash Flow"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Commercial Capital",
            "button_text": "Speak With Capital Team"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Funding Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Icon/Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Working Capital"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description",
          "default": "Fast, flexible funding to manage cash flow gaps, payroll, inventory, and operational expenses."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Request Review"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ]
}
{% endschema %}

