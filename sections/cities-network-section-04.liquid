{% schema %}
{
  "name": "Platform Objectives",
  "tag": "section",
  "class": "section-cities-network-objectives",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Platform <span>Objectives</span>"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "First Paragraph",
      "default": "The FaithBanc™ Cities Network is a growing national ecosystem connecting local communities to modern financial tools and faith-based support systems."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Second Paragraph",
      "default": "Each city operates as a local hub, powered by the FaithBanc™ National Platform, while remaining deeply rooted in neighborhood churches, nonprofits, and community partners.\n\nFaithBanc™ currently operates and expands in strategic cities nationwide, with additional cities launching regularly."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Platform Objectives"
    }
  ]
}
{% endschema %}

<style>
/* Cities Network Section 04 Scoped Rules */

