              <img decoding="async" width="1254" height="1254" src="{{ section.settings.image | image_url: width: 1254 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% else %}
              <img decoding="async" width="1254" height="1254" src="{{ 'cities-network-cta.webp' | asset_url }}" class="attachment-full size-full wp-image-8747" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% endif %}
