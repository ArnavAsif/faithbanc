{% schema %}
{
  "name": "Hero - Payment Processing",
  "tag": "section",
  "class": "section-hero-payment-processing",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Ultimate Faith Banc"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Stop Overpaying for Payment Processing."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Traditional processors take 2.5%\u20133.5% of every transaction. FaithBanc's flat-fee membership model keeps your hard-earned profits where they belong\u2014with you."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "Compare My Fees"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "Become a Processor"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Hero - Payment Processing"
    }
  ]
}
{% endschema %}

