{% schema %}
{
  "name": "Teen Banking Details",
  "tag": "section",
  "class": "section-teen-banking",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc\u2122"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "FaithBanc\u2122 Teen Banking"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Youth debit cards and digital literacy tooling to build solid financial habits early in life."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Find More"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Teen Banking Image"
    }
  ],
  "presets": [
    {
      "name": "Teen Banking Details"
    }
  ]
}
{% endschema %}

