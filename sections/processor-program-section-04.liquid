{% schema %}
{
  "name": "Processor Calculator",
  "tag": "section",
  "class": "section-processor-calculator",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Savings Calculator"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<span>Calculate </span>Your Savings."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Enter your monthly volume and current processing rate. See estimated monthly savings, annual savings, and potential affiliate income in under 30 seconds."
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Start Processor Application"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "Compare Fees"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "calculator_image",
      "label": "Calculator Graphic Image"
    },
    {
      "type": "text",
      "id": "table_note",
      "label": "Comparison Table Note",
      "default": "Competitor pricing varies by account, card type, volume, plan, and service mix. Examples are illustrative."
    }
  ],
  "blocks": [
    {
      "type": "table_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "volume",
          "label": "Monthly Volume",
          "default": "$10,000"
        },
        {
          "type": "text",
          "id": "pushpay",
          "label": "Pushpay Fee",
          "default": "$300 – 400"
        },
        {
          "type": "text",
          "id": "givelify",
          "label": "Givelify Fee",
          "default": "$350 – 400"
        },
        {
          "type": "text",
          "id": "stripe",
          "label": "Stripe Fee",
          "default": "$290 – 320"
        },
        {
          "type": "text",
          "id": "faithbanc",
          "label": "FaithBanc™ Fee",
          "default": "$99.95"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Processor Calculator",
      "blocks": [
        {
          "type": "table_row",
          "settings": {
            "volume": "$10,000",
            "pushpay": "$300 – 400",
            "givelify": "$350 – 400",
            "stripe": "$290 – 320",
            "faithbanc": "$99.95"
          }
        },
        {
          "type": "table_row",
          "settings": {
            "volume": "$25,000",
            "pushpay": "$800 – 1,000",
            "givelify": "$750 – 900",
            "stripe": "$725 – 800",
            "faithbanc": "$99.95"
          }
        },
        {
          "type": "table_row",
          "settings": {
            "volume": "$50,000",
            "pushpay": "$1,500 – 2,000",
            "givelify": "$1,350 – 1,900",
            "stripe": "$1,450 – 1,600",
            "faithbanc": "$99.95"
          }
        },
        {
          "type": "table_row",
          "settings": {
            "volume": "$100,000",
            "pushpay": "$2,700 – 3,350",
            "givelify": "$2,700 – 3,250",
            "stripe": "$2,900 – 3,200",
            "faithbanc": "$99.95"
          }
        }
      ]
    }
  ]
}
{% endschema %}

