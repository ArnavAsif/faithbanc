/* Comparison Table Styles */
.fb-compare-table-wrap {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    font-family: "Inter", "Poppins", Arial, sans-serif;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .fb-compare-table-box {
    width: 100%;
    overflow-x: auto;
    border-radius: 16px;
    background: #FFFFFF;
    box-shadow: 0 20px 55px #E0115F18;
    border: 1px solid #F6D7E7;
  }

  .fb-compare-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    color: #171426;
    font-size: 15px;
  }

  .fb-compare-table thead th {
    background: linear-gradient(90deg, #6A0E69 0%, #E0115F 100%);
    color: #FFFFFF;
    padding: 20px 26px;
    font-size: 14px;
    font-weight: 800;
    text-align: left;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .fb-compare-table thead th:first-child {
    border-top-left-radius: 16px;
  }

  .fb-compare-table thead th:last-child {
    border-top-right-radius: 16px;
    text-align: center;
    background: linear-gradient(90deg, #E0115F 0%, #FF6A2A 100%);
  }

  .fb-compare-table tbody td {
    padding: 21px 26px;
    border-bottom: 1px solid #F3E5EE;
    background: #FFFFFF;
    font-size: 15px;
    font-weight: 500;
    color: #393447;
    white-space: nowrap;
  }

  .fb-compare-table tbody tr:last-child td {
    border-bottom: none;
  }

  .fb-compare-table tbody td:first-child {
    font-weight: 800;
    color: #171426;
  }

  .fb-compare-table tbody td:last-child {
    color: #E0115F;
    font-weight: 900;
    text-align: center;
    background: #FFF3F8;
  }

  .fb-volume-icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    margin-right: 12px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: #FFE6F1;
    color: #E0115F;
    font-size: 10px;
    font-weight: 900;
    vertical-align: middle;
  }

  .fb-table-note {
    margin-top: 14px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: #6F6A78;
    font-size: 13px;
    line-height: 1.6;
  }

  .fb-table-note .fb-note-dot {
    width: 9px;
    height: 9px;
    min-width: 9px;
    margin-top: 6px;
    border-radius: 50%;
    background: #E0115F;
    box-shadow: 0 0 0 4px #FFE1EE;
  }

  @media (max-width: 767px) {
    .fb-compare-table-wrap {
      padding: 0 12px;
    }

    .fb-compare-table-box {
      border-radius: 14px;
    }

    .fb-compare-table {
      min-width: 720px;
      font-size: 14px;
    }

    .fb-compare-table thead th,
    .fb-compare-table tbody td {
      padding: 17px 18px;
    }

    .fb-table-note {
      font-size: 12px;
    }
  }


/* Inline style */
