{% schema %}
{
  "name": "Cities Served",
  "tag": "section",
  "class": "section-cities-network-served",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Cities Currently <span>Served </span>by FaithBanc™"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "FaithBanc™ operates through local church and community partners in the following cities:"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "city_item",
      "name": "City Hub",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "City Name",
          "default": "FaithBanc™ Chicago"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cities Served",
      "blocks": [
        { "type": "city_item", "settings": { "text": "FaithBanc™ City Hubs:" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ Chicago" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ Atlanta" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ Orlando" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ Dallas" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ Los Angeles" } },
        { "type": "city_item", "settings": { "text": "FaithBanc™ New York" } }
      ]
    }
  ]
}
{% endschema %}

<style>
/* Cities Network Section 06 Scoped Rules */

.cities-sec-06-wrapper{
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.elementor-42 .elementor-element.elementor-element-2ec080b6{--display:flex;--flex-direction:column;--container-widget-width:100%;--container-widget-height:initial;--container-widget-flex-grow:0;--container-widget-align-self:initial;--flex-wrap-mobile:wrap;--gap:50px 50px;--row-gap:50px;--column-gap:50px;--padding-left:0px;--padding-right:0px;}
.elementor-42 .elementor-element.elementor-element-2ec080b6:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-2ec080b6 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FFFFFF;}

.elementor-42 .elementor-element.elementor-element-35d33e87{--display:flex;--flex-direction:row;--container-widget-width:initial;--container-widget-height:100%;--container-widget-flex-grow:1;--container-widget-align-self:stretch;--flex-wrap-mobile:wrap;--gap:30px 30px;--row-gap:30px;--column-gap:30px;--overflow:hidden;border-style:solid;--border-style:solid;border-width:1px 1px 1px 1px;--border-top-width:1px;--border-right-width:1px;--border-bottom-width:1px;--border-left-width:1px;border-color:#CFCFCF75;--border-color:#CFCFCF75;border-radius:12px 12px 12px 12px;--padding-top:50px;--padding-bottom:50px;--padding-left:50px;--padding-right:50px;}
.elementor-42 .elementor-element.elementor-element-35d33e87:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-35d33e87 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FAFAFA;}

.elementor-42 .elementor-element.elementor-element-30ad2fc1{--display:flex;--border-radius:15px 15px 15px 15px;}
.elementor-42 .elementor-element.elementor-element-30ad2fc1{--min-height:208px;}
.elementor-42 .elementor-element.elementor-element-30ad2fc1.e-con{--order:-99999 /* order start hack */;}

.elementor-42 .elementor-element.elementor-element-0591db8{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}
.elementor-42 .elementor-element.elementor-element-0591db8 img{width:76%;}

.elementor-42 .elementor-element.elementor-element-7d1cc372{--display:flex;--justify-content:center;}
.elementor-42 .elementor-element.elementor-element-7d1cc372.e-con{--order:-99999 /* order start hack */;}

.elementor-42 .elementor-element.elementor-element-24498a2c{width:var( --container-widget-width, 92% );max-width:92%;--container-widget-width:92%;--container-widget-flex-grow:0;text-align:start;}
.elementor-42 .elementor-element.elementor-element-24498a2c .elementor-heading-title{font-family:"Plus Jakarta Sans", Sans-serif;font-size:42px;font-weight:700;text-transform:capitalize;line-height:55px;letter-spacing:-2.7px;color:var( --e-global-color-text );}
.elementor-42 .elementor-element.elementor-element-24498a2c{width:100%;max-width:100%;}
.elementor-42 .elementor-element.elementor-element-24498a2c .elementor-heading-title{font-size:32px;line-height:1.3em;}
.elementor-42 .elementor-element.elementor-element-24498a2c{text-align:start;}
.elementor-42 .elementor-element.elementor-element-24498a2c .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}

.elementor-42 .elementor-element.elementor-element-571cf9b9{width:100%;max-width:100%;text-align:start;font-family:"Poppins", Sans-serif;font-size:16px;font-weight:400;line-height:29px;letter-spacing:-0.5px;color:var( --e-global-color-secondary );}
.elementor-42 .elementor-element.elementor-element-571cf9b9.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-571cf9b9{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
.elementor-42 .elementor-element.elementor-element-571cf9b9{text-align:start;font-size:15px;}

.elementor-42 .elementor-element.elementor-element-445c8090{width:100%;max-width:100%;--e-icon-list-icon-size:16px;--icon-vertical-align:flex-start;--icon-vertical-offset:4px;}
.elementor-42 .elementor-element.elementor-element-445c8090.elementor-element{--align-self:center;}
.elementor-42 .elementor-element.elementor-element-445c8090 .elementor-icon-list-items:not(.elementor-inline-items) .elementor-icon-list-item:not(:last-child){padding-block-end:calc(5px/2);}
.elementor-42 .elementor-element.elementor-element-445c8090 .elementor-icon-list-items:not(.elementor-inline-items) .elementor-icon-list-item:not(:first-child){margin-block-start:calc(5px/2);}
.elementor-42 .elementor-element.elementor-element-445c8090 .elementor-icon-list-item > .elementor-icon-list-text{font-size:15px;font-weight:400;letter-spacing:-0.6px;color:var( --e-global-color-secondary );transition:color 0.3s;}
.elementor-42 .elementor-element.elementor-element-445c8090{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}

@media(max-width:1024px){
  .elementor-42 .elementor-element.elementor-element-24498a2c{width:100%;max-width:100%;}
  .elementor-42 .elementor-element.elementor-element-24498a2c .elementor-heading-title{font-size:32px;line-height:1.3em;}
  .elementor-42 .elementor-element.elementor-element-571cf9b9{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
  .elementor-42 .elementor-element.elementor-element-445c8090{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
}
@media(max-width:767px){
  .cities-sec-06-wrapper{padding-left:15px;padding-right:15px;}
  .elementor-42 .elementor-element.elementor-element-35d33e87{--gap:20px 20px;--row-gap:20px;--column-gap:20px;--padding-top:15px;--padding-bottom:15px;--padding-left:15px;--padding-right:15px;}
  .elementor-42 .elementor-element.elementor-element-30ad2fc1{--min-height:208px;}
  .elementor-42 .elementor-element.elementor-element-30ad2fc1.e-con{--order:-99999 /* order start hack */;}
  .elementor-42 .elementor-element.elementor-element-0591db8{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}
  .elementor-42 .elementor-element.elementor-element-24498a2c{text-align:start;}
  .elementor-42 .elementor-element.elementor-element-24498a2c .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}
  .elementor-42 .elementor-element.elementor-element-571cf9b9{text-align:start;font-size:15px;}
}
</style>

<div class="elementor elementor-42 cities-sec-06-wrapper">
  <div class="elementor-element elementor-element-2ec080b6 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="2ec080b6" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-35d33e87 e-con-full e-flex e-con e-child animated fadeInUp" data-id="35d33e87" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-30ad2fc1 e-con-full e-flex e-con e-child" data-id="30ad2fc1" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
          <div class="elementor-element elementor-element-0591db8 elementor-widget elementor-widget-image" data-id="0591db8" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img decoding="async" width="923" height="923" src="{{ section.settings.image | image_url: width: 923 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% else %}
              <img decoding="async" width="923" height="923" src="{{ 'cities-network-services.webp' | asset_url }}" class="attachment-full size-full wp-image-8591" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% endif %}
          </div>
        </div>

        <div class="elementor-element elementor-element-7d1cc372 e-con-full e-flex e-con e-child" data-id="7d1cc372" data-element_type="container" data-e-type="container">
          {% if section.settings.heading != blank %}
            <div class="elementor-element elementor-element-24498a2c elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="24498a2c" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
              <h2 class="elementor-heading-title elementor-size-default">
                {{ section.settings.heading }}
              </h2>
            </div>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="elementor-element elementor-element-571cf9b9 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor" data-id="571cf9b9" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
              {{ section.settings.description }}
            </div>
          {% endif %}

          <div class="elementor-element elementor-element-445c8090 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="445c8090" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
            <ul class="elementor-icon-list-items">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                    <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
