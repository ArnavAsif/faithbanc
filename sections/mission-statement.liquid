{% schema %}
{
  "name": "Mission Statement",
  "tag": "section",
  "class": "section-mission-statement",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Statement"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Mission Statement"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "To liberate merchants from excessive fees and foster ethical economic empowerment worldwide."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Become a Processor"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Mission Image"
    }
  ],
  "presets": [
    {
      "name": "Mission Statement"
    }
  ]
}
{% endschema %}

