            <img decoding="async" width="1024" height="887" src="{{ 'fbd-platform-hero.webp' | asset_url }}" class="attachment-full size-full wp-image-8775" alt="{{ section.settings.heading | escape }}" loading="eager">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
