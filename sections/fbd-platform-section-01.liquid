{% schema %}
{
  "name": "FBD Platform Hero",
  "tag": "section",
  "class": "section-fbd-platform-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FBD Platform / Token"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Faith Wallet. <span>Faith Token.</span> Faith Dollar."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A digital finance concept positioning real-world asset education, custody, exchange, and crypto-backed lending — built with compliance at the center."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Request Invite"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "FBD Platform Hero"
    }
  ]
}
{% endschema %}

