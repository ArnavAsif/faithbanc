{% schema %}
{
  "name": "Community Partners",
  "tag": "section",
  "class": "section-cities-network-partners",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "City-Based <span>Church & Community </span>Partners"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Each FaithBanc™ city is supported by:"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "partner_item",
      "name": "Partner Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Item Text",
          "default": "Local churches"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community Partners",
      "blocks": [
        { "type": "partner_item", "settings": { "text": "Local churches" } },
        { "type": "partner_item", "settings": { "text": "Nonprofit organizations" } },
        { "type": "partner_item", "settings": { "text": "Workforce training partners" } },
        { "type": "partner_item", "settings": { "text": "Food banks & distributors" } },
        { "type": "partner_item", "settings": { "text": "Community leaders" } },
        { "type": "partner_item", "settings": { "text": "Together, these partners form localized FaithBanc™ hubs that deliver real impact at the neighborhood level." } }
      ]
    }
  ]
}
{% endschema %}

<style>
/* Cities Network Section 07 Scoped Rules */

.cities-sec-07-wrapper{
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.elementor-42 .elementor-element.elementor-element-2ec080b6{--display:flex;--flex-direction:column;--container-widget-width:100%;--container-widget-height:initial;--container-widget-flex-grow:0;--container-widget-align-self:initial;--flex-wrap-mobile:wrap;--gap:50px 50px;--row-gap:50px;--column-gap:50px;--padding-left:0px;--padding-right:0px;}
.elementor-42 .elementor-element.elementor-element-2ec080b6:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-2ec080b6 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FFFFFF;}

