.elementor-42 .elementor-element.elementor-element-4e92a30f:not(.elementor-motion-effects-element-type-background), .elementor-42 .elementor-element.elementor-element-4e92a30f > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-color:#FAFAFA;}

