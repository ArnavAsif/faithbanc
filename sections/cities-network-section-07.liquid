<div class="elementor elementor-42 cities-sec-07-wrapper">
  <div class="elementor-element elementor-element-2ec080b6 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="2ec080b6" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-4e92a30f e-con-full e-flex e-con e-child animated fadeInUp" data-id="4e92a30f" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-5c9516d3 e-con-full e-flex e-con e-child" data-id="5c9516d3" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
          <div class="elementor-element elementor-element-c1b6fc6 elementor-widget elementor-widget-image" data-id="c1b6fc6" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img decoding="async" width="923" height="923" src="{{ section.settings.image | image_url: width: 923 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% else %}
              <img decoding="async" width="923" height="923" src="{{ 'cities-network-cities.webp' | asset_url }}" class="attachment-full size-full wp-image-8590" alt="{{ section.settings.heading | escape }}" loading="lazy">
            {% endif %}
          </div>
        </div>

        <div class="elementor-element elementor-element-754fd4f7 e-con-full e-flex e-con e-child" data-id="754fd4f7" data-element_type="container" data-e-type="container">
          {% if section.settings.heading != blank %}
            <div class="elementor-element elementor-element-5109418f elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="5109418f" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
              <h2 class="elementor-heading-title elementor-size-default">
                {{ section.settings.heading }}
              </h2>
            </div>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="elementor-element elementor-element-32c35d4f elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor" data-id="32c35d4f" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
