          <div class="elementor-element elementor-element-1478ea14 elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="1478ea14" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
            <ul class="elementor-icon-list-items">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                    <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                  </li>
                {% endif %}
              {% endfor %}
