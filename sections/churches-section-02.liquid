{% schema %}
{
  "name": "Churches Core Benefits",
  "tag": "section",
  "class": "section-churches-benefits",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Core Benefits"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Built for<span> the way</span> ministries actually run."
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "text",
      "id": "card_eyebrow",
      "label": "Card Eyebrow",
      "default": "Processor Program"
    },
    {
      "type": "inline_richtext",
      "id": "card_heading",
      "label": "Card Heading",
      "default": "Your church earns. Members save."
    },
    {
      "type": "textarea",
      "id": "card_description",
      "label": "Card Description",
      "default": "Earn $20/month per approved organization on the $99.95 flat-fee program, plus 0.5% of transaction volume through the portal where approved."
    },
    {
      "type": "textarea",
      "id": "card_highlight",
      "label": "Card Highlight Box Text",
      "default": "100 member businesses processing $1,000/week = $400,000 monthly volume. At a traditional 3% fee, businesses pay roughly $12,000/mo in fees. FaithBanc\u2122\u2019s flat-rate model unlocks meaningful savings \u2014 and potential recurring church revenue."
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit Text",
          "default": "Flat-rate $99.95 processing program \u2014 predictable, simple."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Churches Core Benefits",
      "blocks": [
        {
          "type": "benefit_item",
          "settings": {
            "text": "Flat-rate $99.95 processing program \u2014 predictable, simple."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Modern giving tools: kiosks, handheld devices, online and recurring tithes."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Campaign tracking with transparent reporting for pastors and finance teams."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Member-business savings: connect business owners in your congregation to processing relief."
          }
        }
      ]
    }
  ]
}
{% endschema %}

