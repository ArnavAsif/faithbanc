{% schema %}
{
  "name": "Processor Economics",
  "tag": "section",
  "class": "section-processor-economics",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Program Economics"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Simple. <span>Recurring. </span>Transparent."
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card Title",
      "default": "Flat Monthly Rate"
    },
    {
      "type": "text",
      "id": "card_price",
      "label": "Card Price",
      "default": "$99.95"
    },
    {
      "type": "text",
      "id": "card_period",
      "label": "Card Period",
      "default": "per month"
    },
    {
      "type": "text",
      "id": "card_referral_label",
      "label": "Referral Label",
      "default": "Per approved referral"
    },
    {
      "type": "text",
      "id": "card_referral_value",
      "label": "Referral Value",
      "default": "$20 / mo"
    },
    {
      "type": "text",
      "id": "card_volume_label",
      "label": "Volume Participation Label",
      "default": "Volume participation*"
    },
    {
      "type": "text",
      "id": "card_volume_value",
      "label": "Volume Participation Value",
      "default": "0.5%"
    },
    {
      "type": "text",
      "id": "card_btn_text",
      "label": "Card Button Text",
      "default": "Apply Now"
    },
    {
      "type": "url",
      "id": "card_btn_url",
      "label": "Card Button URL"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Benefit Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Processor Economics",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "$99.95 flat rate per month — shown in red across hero, calculator, comparison, and CTA."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Approved affiliates, churches, or organizations may earn $20 per month for each approved organization that joins via their referral link or portal."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Approved partners may also participate in 0.5% of transaction volume processed through their portal, subject to program terms, payment network rules, underwriting, and partner approval."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Referral tracking captures affiliate code, church code, UTM parameters, landing page URL, and source campaign."
          }
        }
      ]
    }
  ]
}
{% endschema %}

