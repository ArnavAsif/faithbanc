{% schema %}
{
  "name": "Contact Hero",
  "tag": "section",
  "class": "section-contact-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Get in Touch"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Submit Your <span>Inquiry.</span>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tell us what you’re interested in — Processor Program, Business Processing, Church Partnership, Debit Card, Personal Services, FBD Platform, Investor Access, or Community Hub — and we’ll route your request to the right team."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Contact Hero"
    }
  ]
}
{% endschema %}

<style>
/* Contact Section 01 Scoped Rules */

.elementor-8415 .elementor-element.elementor-element-564f925{--display:flex;--min-height:0px;--flex-direction:row;--container-widget-width:initial;--container-widget-height:100%;--container-widget-flex-grow:1;--container-widget-align-self:stretch;--flex-wrap-mobile:wrap;--padding-top:150px;--padding-bottom:100px;--padding-left:0px;--padding-right:0px;}
.elementor-8415 .elementor-element.elementor-element-564f925:not(.elementor-motion-effects-element-type-background), .elementor-8415 .elementor-element.elementor-element-564f925 > .elementor-motion-effects-container > .elementor-motion-effects-layer{background-image:url("{{ 'contact-hero-bg.webp' | asset_url }}");background-position:center center;background-repeat:no-repeat;background-size:cover;}
.elementor-8415 .elementor-element.elementor-element-564f925{--content-width:1200px;}
.elementor-8415 .elementor-element.elementor-element-564f925{--padding-top:120px;--padding-bottom:80px;--padding-left:15px;--padding-right:15px;}

.elementor-8415 .elementor-element.elementor-element-e58de99{--display:flex;--flex-direction:column;--container-widget-width:100%;--container-widget-height:initial;--container-widget-flex-grow:0;--container-widget-align-self:initial;--flex-wrap-mobile:wrap;--justify-content:center;--padding-top:0px;--padding-bottom:0px;--padding-left:0px;--padding-right:0px;}

.elementor-8415 .elementor-element.elementor-element-46e7aca .elementor-button{background-color:var( --e-global-color-0587ab8 );font-family:"Poppins", Sans-serif;font-size:13px;font-weight:500;text-transform:uppercase;fill:var( --e-global-color-66d3c96 );color:var( --e-global-color-66d3c96 );border-radius:45px 45px 45px 45px;padding:9px 25px 9px 25px;}
.elementor-8415 .elementor-element.elementor-element-46e7aca.elementor-element{--align-self:flex-start;}
.elementor-8415 .elementor-element.elementor-element-46e7aca.elementor-element{--align-self:center;}

.elementor-8415 .elementor-element.elementor-element-db0ff71{width:100%;max-width:100%;text-align:start;}
.elementor-8415 .elementor-element.elementor-element-db0ff71 .elementor-heading-title{font-family:"Plus Jakarta Sans", Sans-serif;font-size:53px;font-weight:600;text-transform:capitalize;line-height:67px;letter-spacing:-2.7px;color:var( --e-global-color-secondary );}
.elementor-8415 .elementor-element.elementor-element-db0ff71{width:100%;max-width:100%;}
.elementor-8415 .elementor-element.elementor-element-db0ff71 .elementor-heading-title{font-size:32px;line-height:1.3em;}
.elementor-8415 .elementor-element.elementor-element-db0ff71{text-align:center;}
.elementor-8415 .elementor-element.elementor-element-db0ff71 .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}

.gradient-text span{
    background: linear-gradient(135deg,#FF5722 0%,#FF3366 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.elementor-8415 .elementor-element.elementor-element-101446a{width:100%;max-width:100%;text-align:start;font-family:"Poppins", Sans-serif;font-size:16px;font-weight:400;line-height:29px;letter-spacing:-0.5px;color:var( --e-global-color-secondary );}
.elementor-8415 .elementor-element.elementor-element-101446a.elementor-element{--align-self:center;}
