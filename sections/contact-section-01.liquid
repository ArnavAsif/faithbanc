@media(max-width:1024px){
  .elementor-8415 .elementor-element.elementor-element-db0ff71{width:100%;max-width:100%;}
  .elementor-8415 .elementor-element.elementor-element-db0ff71 .elementor-heading-title{font-size:32px;line-height:1.3em;}
  .elementor-8415 .elementor-element.elementor-element-101446a{width:var( --container-widget-width, 588px );max-width:588px;--container-widget-width:588px;--container-widget-flex-grow:0;}
}
@media(min-width:768px){
  .elementor-8415 .elementor-element.elementor-element-564f925{--content-width:1200px;}
}
@media(max-width:767px){
  .elementor-8415 .elementor-element.elementor-element-564f925{--padding-top:120px;--padding-bottom:80px;--padding-left:15px;--padding-right:15px;}
  .elementor-8415 .elementor-element.elementor-element-e58de99{--padding-top:0px;--padding-bottom:0px;--padding-left:0px;--padding-right:0px;}
  .elementor-8415 .elementor-element.elementor-element-46e7aca.elementor-element{--align-self:center;}
  .elementor-8415 .elementor-element.elementor-element-db0ff71{text-align:center;}
  .elementor-8415 .elementor-element.elementor-element-db0ff71 .elementor-heading-title{font-size:26px;line-height:1.3em;letter-spacing:-1.5px;}
  .elementor-8415 .elementor-element.elementor-element-101446a{text-align:center;font-size:15px;}
  .elementor-8415 .elementor-element.elementor-element-090e649.e-con{--order:-99999 /* order start hack */;}
  .elementor-8415 .elementor-element.elementor-element-39e8340{margin:-54px 0px calc(var(--kit-widget-spacing, 0px) + -24px) 0px;}
  .elementor-8415 .elementor-element.elementor-element-39e8340 img{max-width:100%;}
}
</style>

<div class="elementor elementor-8415">
  <div class="elementor-element elementor-element-564f925 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="564f925" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}' {% if section.settings.bg_image != blank %}style="background-image: url('{{ section.settings.bg_image | image_url: width: 2560 }}');"{% endif %}>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-e58de99 e-con-full e-flex e-con e-child" data-id="e58de99" data-element_type="container" data-e-type="container">
        {% if section.settings.badge_text != blank %}
          <div class="elementor-element elementor-element-46e7aca elementor-align-center elementor-widget elementor-widget-button" data-id="46e7aca" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
            <a class="elementor-button elementor-button-link elementor-size-sm" href="{{ section.settings.badge_url | default: '#' }}">
              <span class="elementor-button-content-wrapper">
                <span class="elementor-button-text">{{ section.settings.badge_text }}</span>
              </span>
            </a>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <div class="elementor-element elementor-element-db0ff71 elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading animated fadeInUp" data-id="db0ff71" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="heading.default">
            <h1 class="elementor-heading-title elementor-size-default">
              {{ section.settings.heading }}
            </h1>
          </div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="elementor-element elementor-element-101446a elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor animated fadeInUp" data-id="101446a" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="text-editor.default">
            <p>{{ section.settings.description }}</p>
          </div>
        {% endif %}
      </div>

      <div class="elementor-element elementor-element-090e649 e-con-full e-flex e-con e-child" data-id="090e649" data-element_type="container" data-e-type="container">
        <div class="elementor-element elementor-element-39e8340 elementor-widget elementor-widget-image animated fadeInRight" data-id="39e8340" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInRight"}' data-widget_type="image.default">
          {% if section.settings.hero_image != blank %}
            <img decoding="async" width="1254" height="1254" src="{{ section.settings.hero_image | image_url: width: 1254 }}" class="attachment-full size-full" alt="{{ section.settings.heading | escape }}" loading="eager">
          {% else %}
            <img decoding="async" width="1254" height="1254" src="{{ 'contact-hero.png' | asset_url }}" class="attachment-full size-full wp-image-8813" alt="{{ section.settings.heading | escape }}" loading="eager">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
