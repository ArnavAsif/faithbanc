.elementor-8415 .elementor-element.elementor-element-39e8340{text-align:end;}
.elementor-8415 .elementor-element.elementor-element-39e8340 img{max-width:91%;}
.elementor-8415 .elementor-element.elementor-element-39e8340{margin:-54px 0px calc(var(--kit-widget-spacing, 0px) + -24px) 0px;}
