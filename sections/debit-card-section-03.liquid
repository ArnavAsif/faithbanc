{% schema %}
{
  "name": "Debit Card Waitlist",
  "tag": "section",
  "class": "section-debit-card-waitlist",
  "settings": [
    {
      "type": "text",
      "id": "form_btn_text",
      "label": "Form Button Text",
      "default": "Join Waitlist"
    },
    {
      "type": "header",
      "content": "Compliance Note"
    },
    {
      "type": "inline_richtext",
      "id": "compliance_heading",
      "label": "Compliance Heading",
      "default": "Compliance Note"
    },
    {
      "type": "textarea",
      "id": "compliance_text",
      "label": "Compliance Text",
      "default": "The FaithBanc\u2122 Global Debit Card is offered through partner banking and payment infrastructure where required. Availability of features such as crypto/stablecoin funding, wires, and currency support is subject to jurisdiction, partner approval, KYC/AML review, and applicable law."
    },
    {
      "type": "image_picker",
      "id": "compliance_bg",
      "label": "Compliance Background Image"
    }
  ],
  "presets": [
    {
      "name": "Debit Card Waitlist"
    }
  ]
}
{% endschema %}

