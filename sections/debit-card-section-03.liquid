{% schema %}
{
  "name": "Debit Card Compliance",
  "tag": "section",
  "class": "section-debit-card-compliance",
  "settings": [
    {
      "type": "text",
      "id": "compliance_heading",
      "label": "Compliance Heading",
      "default": "Compliance Note"
    },
    {
      "type": "textarea",
      "id": "compliance_text_1",
      "label": "Compliance Paragraph 1",
      "default": "The FaithBanc\u2122 Global Debit Card is offered through partner banking and payment infrastructure where required."
    },
    {
      "type": "textarea",
      "id": "compliance_text_2",
      "label": "Compliance Paragraph 2",
      "default": "Availability of features such as crypto/stablecoin funding, wires, and currency support is subject to jurisdiction, partner approval, KYC/AML review, and applicable law."
    },
    {
      "type": "image_picker",
      "id": "compliance_image",
      "label": "Compliance Graphic"
    }
  ],
  "presets": [
    {
      "name": "Debit Card Compliance"
    }
  ]
}
{% endschema %}

<style>
/* Scoped Debit Card Section 03 (Compliance Note) Styles */
.debit-sec3-wrapper {
  padding: 10px 0 80px 0;
  width: 100%;
  box-sizing: border-box;
}

.debit-sec3-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  box-sizing: border-box;
}

.debit-compliance-card {
  background-color: #F2295B;
  background-image: url('{{ "debit-card-compliance-bg.webp" | asset_url }}');
  background-position: right center;
  background-repeat: no-repeat;
  background-size: cover;
  border-radius: 16px;
  min-height: 420px;
  padding: 50px 60px;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 10px 30px rgba(242, 41, 91, 0.12);
}

.debit-compliance-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 87, 34, 0.25) 0%, rgba(242, 41, 91, 0) 100%);
  pointer-events: none;
}

.debit-compliance-content {
  max-width: 580px;
  position: relative;
  z-index: 2;
}

.debit-compliance-title {
  font-family: "Plus Jakarta Sans", "Poppins", sans-serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.5px;
  color: #FFFFFF;
  margin: 0 0 24px 0;
}

.debit-compliance-text {
  font-family: "Poppins", sans-serif;
  font-size: 15px;
  font-weight: 400;
  line-height: 1.65;
  color: #FFFFFF;
  margin: 0 0 16px 0;
}

.debit-compliance-text:last-child {
  margin-bottom: 0;
}

/* Responsive Breakpoints */
@media (max-width: 991px) {
  .debit-compliance-card {
    padding: 40px 32px;
    min-height: 360px;
  }
  .debit-compliance-title {
    font-size: 28px;
  }
}

@media (max-width: 767px) {
  .debit-sec3-wrapper {
    padding: 10px 0 50px 0;
  }
  .debit-compliance-card {
    padding: 32px 20px;
    min-height: auto;
    background-position: center right;
  }
  .debit-compliance-title {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .debit-compliance-text {
    font-size: 14px;
    line-height: 1.55;
  }
}
</style>

<div class="debit-sec3-wrapper">
  <div class="debit-sec3-container">
    <div class="debit-compliance-card"
      {% if section.settings.compliance_image != blank %}
        style="background-image: url('{{ section.settings.compliance_image | image_url: width: 1600 }}');"
      {% endif %}>
      <div class="debit-compliance-content">
        {% if section.settings.compliance_heading != blank %}
          <h2 class="debit-compliance-title">
            {{ section.settings.compliance_heading }}
          </h2>
        {% endif %}

        {% if section.settings.compliance_text_1 != blank %}
          <p class="debit-compliance-text">
            {{ section.settings.compliance_text_1 }}
          </p>
        {% endif %}

        {% if section.settings.compliance_text_2 != blank %}
          <p class="debit-compliance-text">
            {{ section.settings.compliance_text_2 }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
