{% schema %}
{
  "name": "Processor Program Hero",
  "tag": "section",
  "class": "section-processor-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Processor Program"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Become <span>Your Own </span>Processor."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Turn your network into recurring monthly income while helping churches, businesses, nonprofits, and community organizations save money on payment processing."
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Start Processor Application"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "Compare Fees"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Processor Program Hero"
    }
  ]
}
{% endschema %}

