{% schema %}
{
  "name": "FBD Platform Disclaimer",
  "tag": "section",
  "class": "section-fbd-platform-disclaimer",
  "settings": [
    {
      "type": "text",
      "id": "disclaimer_heading",
      "label": "Disclaimer Heading",
      "default": "Important Disclaimer"
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Disclaimer Text",
      "default": "All FBD Platform and token information is conceptual, subject to regulatory review, partner approvals, and KYC/AML. Nothing on this page is an offer to sell securities or investment advice."
    },
    {
      "type": "image_picker",
      "id": "disclaimer_bg",
      "label": "Disclaimer Background Graphic"
    }
  ],
  "presets": [
    {
      "name": "FBD Platform Disclaimer"
    }
  ]
}
