              <span class="elementor-button-content-wrapper">
                <span class="elementor-button-text">{{ section.settings.badge_text }}</span>
              </span>
            </a>
          </div>
        {% endif %}

        <div class="elementor-element elementor-element-851907d elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading elementor-invisible" data-id="851907d" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInUp&quot;}" data-widget_type="heading.default">
          <h2 class="elementor-heading-title elementor-size-default">
            {{ section.settings.heading }}
          </h2>
        </div>

        <div class="elementor-element elementor-element-20acb92 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor elementor-invisible" data-id="20acb92" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInUp&quot;}" data-widget_type="text-editor.default">
          {{ section.settings.description }}
        </div>

        {% if section.settings.button_text != blank %}
          <div class="elementor-element elementor-element-0028c6b elementor-align-left elementor-tablet-align-left elementor-mobile-align-left elementor-widget elementor-widget-button elementor-invisible" data-id="0028c6b" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInUp&quot;,&quot;_animation_delay&quot;:400}" data-widget_type="button.default">
            <a class="elementor-button elementor-button-link elementor-size-sm" href="{{ section.settings.button_url | default: '/contact-us' }}">
              <span class="elementor-button-content-wrapper">
                <span class="elementor-button-icon">
                  <svg aria-hidden="true" class="e-font-icon-svg e-fas-paper-plane" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
                    <path d="M476 3.2L12.5 270.6c-18.1 10.4-15.8 35.6 2.2 43.2L121 358.4l287.3-253.2c5.5-4.9 13.3 2.6 8.6 8.3L176 407v80.5c0 23.6 28.5 32.9 42.5 15.8L282 426l124.6 52.2c14.2 6 30.4-2.9 33-18.2l72-432C515 7.8 493.3-6.8 476 3.2z"></path>
                  </svg>
                </span>
                <span class="elementor-button-text">{{ section.settings.button_text }}</span>
              </span>
            </a>
          </div>
        {% endif %}
      </div>

      <div class="elementor-element elementor-element-fb7bf5c e-con-full e-flex e-con e-child" data-id="fb7bf5c" data-element_type="container" data-e-type="container">
        <div class="elementor-element elementor-element-597c2d4 elementor-widget elementor-widget-image elementor-invisible" data-id="597c2d4" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInRight&quot;}" data-widget_type="image.default">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1024 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="1024" height="1024" class="attachment-full size-full" loading="lazy" decoding="async">
          {% else %}
            <img decoding="async" width="1024" height="1024" src="{{ 'businesses-cta.webp' | asset_url }}" class="attachment-full size-full wp-image-8704" alt="{{ section.settings.heading | escape }}" loading="lazy">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
