@media(max-width:1024px){.elementor-8708 .elementor-element.elementor-element-3324890{--min-height:580px;--padding-top:150px;--padding-bottom:50px;--padding-left:0px;--padding-right:0px;}.elementor-8708 .elementor-element.elementor-element-851907d{width:100%;max-width:100%;}.elementor-8708 .elementor-element.elementor-element-851907d .elementor-heading-title{font-size:32px;line-height:1.3em;}.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button{font-size:15px;padding:16px 35px 16px 35px;}.elementor-8708 .elementor-element.elementor-element-597c2d4{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}}
@media(max-width:767px){.elementor-8708 .elementor-element.elementor-element-3324890{--padding-top:50px;--padding-bottom:50px;--padding-left:15px;--padding-right:15px;}.elementor-8708 .elementor-element.elementor-element-c78d7b4 .elementor-button{font-size:10px;}.elementor-8708 .elementor-element.elementor-element-851907d{text-align:start;}.elementor-8708 .elementor-element.elementor-element-851907d .elementor-heading-title{font-size:23px;line-height:1.3em;letter-spacing:-1.5px;}.elementor-8708 .elementor-element.elementor-element-20acb92{width:100%;max-width:100%;}.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button{font-size:12px;padding:15px 15px 15px 15px;}.elementor-8708 .elementor-element.elementor-element-fb7bf5c.e-con{--order:-99999 /* order start hack */;}.elementor-8708 .elementor-element.elementor-element-597c2d4{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}.elementor-8708 .elementor-element.elementor-element-597c2d4 img{width:100%;}}

.gradient-text span{
    background: linear-gradient(135deg,#FF5722 0%,#FF3366 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}


.purple-glow-section {
  position: relative;
  overflow: hidden; /* ensure blur doesn't overflow */
  background-color: #ffffff; /* base background */
}

.purple-glow-section::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  background: radial-gradient(circle at top right, rgba(173, 109, 244, 0.5), transparent 70%);
  filter: blur(80px);
  z-index: 0;
}

/* Ensure section content is above the glow */
.purple-glow-section .elementor-container {
  position: relative;
  z-index: 1;
}

</style>

<div class="elementor elementor-8708">
  <div class="elementor-element elementor-element-3324890 purple-glow-section e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="3324890" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-58e4ffd e-con-full e-flex e-con e-child" data-id="58e4ffd" data-element_type="container" data-e-type="container">
        {% if section.settings.badge_text != blank %}
          <div class="elementor-element elementor-element-c78d7b4 elementor-align-left elementor-widget elementor-widget-button elementor-invisible" data-id="c78d7b4" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInUp&quot;}" data-widget_type="button.default">
