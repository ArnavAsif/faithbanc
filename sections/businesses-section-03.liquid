{% schema %}
{
  "name": "Businesses Call to Action",
  "tag": "section",
  "class": "section-businesses-cta",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc\u2122"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Switch to<span> ONE FLAT RATE </span>& Save More."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Submit your last 3 processing statements for a no-obligation savings review."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Request Statement Review"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Graphic Image"
    }
  ],
  "presets": [
    {
      "name": "Businesses Call to Action"
    }
  ]
}
{% endschema %}

<style>
/* Section Scoped Rules */
.elementor-8708 .elementor-element.elementor-element-3324890{--display:flex;--min-height:0px;--flex-direction:row;--container-widget-width:initial;--container-widget-height:100%;--container-widget-flex-grow:1;--container-widget-align-self:stretch;--flex-wrap-mobile:wrap;--padding-top:80px;--padding-bottom:80px;--padding-left:0px;--padding-right:0px;}
.elementor-8708 .elementor-element.elementor-element-58e4ffd{--display:flex;--justify-content:center;}
.elementor-8708 .elementor-element.elementor-element-c78d7b4 .elementor-button{background-color:#FF572230;font-family:"Poppins", Sans-serif;font-size:13px;font-weight:400;text-transform:uppercase;fill:var( --e-global-color-secondary );color:var( --e-global-color-secondary );border-radius:45px 45px 45px 45px;padding:10px 25px 10px 25px;}
.elementor-8708 .elementor-element.elementor-element-851907d{width:var( --container-widget-width, 69% );max-width:69%;--container-widget-width:69%;--container-widget-flex-grow:0;text-align:start;}
.elementor-8708 .elementor-element.elementor-element-851907d .elementor-heading-title{font-family:"Plus Jakarta Sans", Sans-serif;font-size:36px;font-weight:700;text-transform:capitalize;line-height:49px;letter-spacing:-2.7px;color:var( --e-global-color-text );}
.elementor-8708 .elementor-element.elementor-element-20acb92{width:var( --container-widget-width, 82% );max-width:82%;--container-widget-width:82%;--container-widget-flex-grow:0;text-align:start;font-family:"Poppins", Sans-serif;font-size:15px;font-weight:400;line-height:28px;letter-spacing:-0.5px;color:var( --e-global-color-91f3e4c );}
.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button{background-color:transparent;font-family:"Poppins", Sans-serif;font-size:14px;font-weight:300;text-transform:uppercase;font-style:normal;line-height:14px;letter-spacing:-0.2px;fill:#FFFFFF;color:#FFFFFF;background-image:linear-gradient(148deg, #E42981 0%, #FEA035 100%);border-style:solid;border-width:1px 1px 1px 1px;border-color:var( --e-global-color-832bc31 );border-radius:32px 32px 32px 32px;padding:18px 35px 18px 35px;}
.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button:hover, .elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button:focus{background-color:var( --e-global-color-3d786e9 );color:var( --e-global-color-0587ab8 );}
.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button-content-wrapper{flex-direction:row;}
.elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button:hover svg, .elementor-8708 .elementor-element.elementor-element-0028c6b .elementor-button:focus svg{fill:var( --e-global-color-0587ab8 );}
.elementor-8708 .elementor-element.elementor-element-fb7bf5c{--display:flex;--justify-content:center;}
.elementor-8708 .elementor-element.elementor-element-fb7bf5c.e-con{--order:-99999 /* order start hack */;}
.elementor-8708 .elementor-element.elementor-element-597c2d4{margin:0px 0px calc(var(--kit-widget-spacing, 0px) + 0px) 0px;}
