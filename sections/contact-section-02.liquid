{% schema %}
{
  "name": "Contact Form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "name_label",
      "label": "Name Field Label",
      "default": "Full Name"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Placeholder",
      "default": "Start typing..."
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company Field Label",
      "default": "Company Name"
    },
    {
      "type": "text",
      "id": "company_placeholder",
      "label": "Company Placeholder",
      "default": "Start typing..."
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "City Field Label",
      "default": "City"
    },
    {
      "type": "textarea",
      "id": "city_options",
      "label": "City Dropdown Options (one per line)",
      "default": "New York\nLos Angeles\nChicago\nHouston\nPhoenix\nPhiladelphia\nSan Antonio\nSan Diego\nDallas\nSan Jose"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Field Label",
      "default": "Additional Information"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message Placeholder",
      "default": "Start typing..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Pay 2.22$ membership to join"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}

<style>
/* Contact Section 02 Scoped Rules */
.section-contact-form {
  position: relative;
  z-index: 5;
  margin-top: -73px;
  overflow: visible;
  width: 100%;
}

.elementor-8415 .elementor-element.elementor-element-63d52c3 {
  position: relative;
  width: 100%;
  padding-top: 0px;
  padding-bottom: 80px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.elementor-8415 .elementor-element.elementor-element-63d52c3 .e-con-inner {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
  display: flex;
  justify-content: center;
  box-sizing: border-box;
}

.elementor-8415 .elementor-element.elementor-element-bd31ec2 {
  width: 80%;
  max-width: 960px;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-self: center;
  box-sizing: border-box;
}

.elementor-8415 .elementor-element.elementor-element-9af91f7 {
  width: 100%;
  background-color: var(--e-global-color-0587ab8, #FFFFFF);
  border: 1px solid #FF572252;
  border-radius: 15px;
  padding: 50px;
  box-sizing: border-box;
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.04);
}

.elementor-8415 .elementor-element.elementor-element-db95a2a {
  width: 100%;
  max-width: 100%;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-form-fields-wrapper {
  margin-left: -10px;
  margin-right: -10px;
  margin-bottom: -20px;
  display: flex;
  flex-wrap: wrap;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-field-group {
  padding-right: 10px;
  padding-left: 10px;
  margin-bottom: 20px;
  box-sizing: border-box;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-col-50 {
  width: 50%;
  flex: 0 0 50%;
  max-width: 50%;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-col-100 {
  width: 100%;
  flex: 0 0 100%;
  max-width: 100%;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-field-group > label {
  color: var(--e-global-color-text, #000000);
  font-family: "Poppins", Sans-serif;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -1.1px;
  display: block;
  padding-bottom: 13px;
  margin: 0;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-field-group .elementor-field {
  color: var(--e-global-color-secondary, #221B1A);
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
  font-weight: 400;
  width: 100%;
  border-color: #FF572245;
  border-width: 1px;
  border-radius: 2px;
  border-style: solid;
  padding: 12px 14px;
  box-sizing: border-box;
  background-color: transparent;
  outline: none;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-field-group .elementor-field::placeholder {
  color: #a0a0a0;
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-select-wrapper {
  position: relative;
  width: 100%;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-select-wrapper select {
  color: var(--e-global-color-secondary, #221B1A);
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
  font-weight: 400;
  width: 100%;
  border-color: #FF572245;
  border-width: 1px;
  border-radius: 2px;
  border-style: solid;
  padding: 12px 14px;
  background: transparent;
  appearance: none;
  -webkit-appearance: none;
  box-sizing: border-box;
  cursor: pointer;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .select-caret-down-wrapper {
  position: absolute;
  top: 50%;
  right: 15px;
  transform: translateY(-50%);
  pointer-events: none;
  width: 12px;
  height: 12px;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .select-caret-down-wrapper svg {
  width: 100%;
  height: 100%;
  fill: #777;
  display: block;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-upload-field {
  font-family: "Poppins", Sans-serif;
  font-size: 13px;
  color: #333;
  padding: 4px 0;
  cursor: pointer;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-button {
  font-family: "Poppins", Sans-serif;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.4px;
  border-radius: 45px;
  background-color: var(--e-global-color-832bc31, #FF5722);
  color: var(--e-global-color-text, #000000);
  width: 100%;
  border: none;
  padding: 16px 30px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: block;
  text-align: center;
}

.elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-button:hover {
  opacity: 0.9;
}

@media (max-width: 1024px) {
  .section-contact-form {
    margin-top: 0px;
  }
  .elementor-8415 .elementor-element.elementor-element-63d52c3 {
    padding-top: 50px;
    padding-bottom: 50px;
  }
  .elementor-8415 .elementor-element.elementor-element-bd31ec2 {
    width: 90%;
  }
}

@media (max-width: 767px) {
  .section-contact-form {
    margin-top: 0px;
  }
  .elementor-8415 .elementor-element.elementor-element-63d52c3 {
    padding-top: 40px;
    padding-bottom: 50px;
  }
  .elementor-8415 .elementor-element.elementor-element-bd31ec2 {
    width: 100%;
  }
  .elementor-8415 .elementor-element.elementor-element-9af91f7 {
    padding: 30px 20px;
  }
  .elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-col-50 {
    width: 100%;
    flex: 0 0 100%;
    max-width: 100%;
  }
  .elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-field-group > label {
    font-size: 14px;
  }
  .elementor-8415 .elementor-element.elementor-element-db95a2a .elementor-button {
    font-size: 14px;
    padding: 14px 20px;
  }
}
</style>

<div class="elementor elementor-8415">
  <div class="elementor-element elementor-element-63d52c3 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="63d52c3" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-bd31ec2 e-con-full e-flex e-con e-child" data-id="bd31ec2" data-element_type="container" data-e-type="container">
        <div class="elementor-element elementor-element-9af91f7 e-con-full e-flex e-con e-child animated fadeInUp" data-id="9af91f7" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
          <div class="elementor-element elementor-element-db95a2a elementor-widget__width-inherit elementor-button-align-stretch elementor-widget elementor-widget-form" data-id="db95a2a" data-element_type="widget" data-e-type="widget" data-widget_type="form.default">
            {%- form 'contact', id: 'ContactUsForm', class: 'elementor-form' -%}
              {%- if form.posted_successfully? -%}
                <div class="elementor-message elementor-message-success" role="status" style="margin-bottom: 20px; padding: 14px 20px; border-radius: 4px; background: #e8f5e9; color: #2e7d32; font-family: 'Poppins', sans-serif; font-size: 14px;">
                  {{ 'templates.contact.form.post_success' | t | default: 'Thanks for contacting us. We will get back to you as soon as possible.' }}
                </div>
              {%- elsif form.errors -%}
                <div class="elementor-message elementor-message-danger" role="alert" style="margin-bottom: 20px; padding: 14px 20px; border-radius: 4px; background: #ffebee; color: #c62828; font-family: 'Poppins', sans-serif; font-size: 14px;">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <!-- Hidden email field ensures Shopify contact form handler receives email without error -->
              <input type="hidden" name="contact[email]" id="form-field-email" value="{% if customer %}{{ customer.email }}{% else %}inquiry@faithbanc.com{% endif %}">

              <div class="elementor-form-fields-wrapper elementor-labels-above">
                <div class="elementor-field-type-text elementor-field-group elementor-column elementor-field-group-name elementor-col-50 elementor-field-required">
                  <label for="form-field-name" class="elementor-field-label">
                    {{ section.settings.name_label | default: 'Full Name' }}
                  </label>
                  <input size="1" type="text" name="contact[name]" id="form-field-name" class="elementor-field elementor-size-md elementor-field-textual" placeholder="{{ section.settings.name_placeholder | default: 'Start typing...' }}" required="required">
                </div>

                <div class="elementor-field-type-text elementor-field-group elementor-column elementor-field-group-field_ed52397 elementor-col-50">
                  <label for="form-field-field_ed52397" class="elementor-field-label">
                    {{ section.settings.company_label | default: 'Company Name' }}
                  </label>
                  <input size="1" type="text" name="contact[company]" id="form-field-field_ed52397" class="elementor-field elementor-size-md elementor-field-textual" placeholder="{{ section.settings.company_placeholder | default: 'Start typing...' }}">
                </div>

                <div class="elementor-field-type-select elementor-field-group elementor-column elementor-field-group-field_d39b9c2 elementor-col-100">
                  <label for="form-field-field_d39b9c2" class="elementor-field-label">
                    {{ section.settings.city_label | default: 'City' }}
                  </label>
                  <div class="elementor-field elementor-select-wrapper remove-before">
                    <div class="select-caret-down-wrapper">
                      <svg aria-hidden="true" class="e-font-icon-svg e-eicon-caret-down" viewBox="0 0 571.4 571.4" xmlns="http://www.w3.org/2000/svg"><path d="M571 393Q571 407 561 418L311 668Q300 679 286 679T261 668L11 418Q0 407 0 393T11 368 36 357H536Q550 357 561 368T571 393Z"></path></svg>
                    </div>
                    <select name="contact[city]" id="form-field-field_d39b9c2" class="elementor-field-textual elementor-size-md">
                      {% assign city_list = section.settings.city_options | newline_to_br | split: '<br />' %}
                      {% for city in city_list %}
                        {% assign clean_city = city | strip %}
                        {% if clean_city != blank %}
                          <option value="{{ clean_city | escape }}">{{ clean_city }}</option>
                        {% endif %}
                      {% endfor %}
                    </select>
                  </div>
                </div>

                <div class="elementor-field-type-textarea elementor-field-group elementor-column elementor-field-group-message elementor-col-100">
                  <label for="form-field-message" class="elementor-field-label">
                    {{ section.settings.message_label | default: 'Additional Information' }}
                  </label>
                  <textarea class="elementor-field-textual elementor-field elementor-size-md" name="contact[body]" id="form-field-message" rows="6" placeholder="{{ section.settings.message_placeholder | default: 'Start typing...' }}"></textarea>
                </div>

                <div class="elementor-field-type-upload elementor-field-group elementor-column elementor-field-group-field_d6707f8 elementor-col-100">
                  <input type="file" name="contact[file]" id="form-field-field_d6707f8" class="elementor-field elementor-size-md elementor-upload-field">
                </div>

                <div class="elementor-field-group elementor-column elementor-field-type-submit elementor-col-100 e-form__buttons">
                  <button class="elementor-button elementor-size-md" type="submit">
                    <span class="elementor-button-content-wrapper">
                      <span class="elementor-button-text">{{ section.settings.button_text | default: 'Pay 2.22$ membership to join' }}</span>
                    </span>
                  </button>
                </div>
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

