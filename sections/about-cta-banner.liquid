</div>

{% schema %}
{
  "name": "About - CTA Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FaithBanc™ Nulla eget ullamcorper sem. Sed tristique​"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "If your church or nonprofit wants to feed families, empower the homeless, teach financial literacy, or train residents for real careers — FaithBanc™ is ready to partner with you today."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "About - CTA Banner"
    }
  ]
}
{% endschema %}
