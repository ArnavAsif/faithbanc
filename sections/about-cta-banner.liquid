      <div class="elementor-element elementor-element-4d8c802 e-con-full e-flex e-con e-child elementor-invisible" data-id="4d8c802" data-element_type="container" data-e-type="container" data-settings='{"background_background":"gradient","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-d48be3e elementor-widget__width-initial elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="d48be3e" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"none"}' data-widget_type="heading.default">
          <h2 class="elementor-heading-title elementor-size-default">
            {{ section.settings.heading | default: "FaithBanc™ Nulla eget ullamcorper sem. Sed tristique​" }}
          </h2>
        </div>

        {% if section.settings.text != blank %}
          <div class="elementor-element elementor-element-d7ab969 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget elementor-widget-text-editor" data-id="d7ab969" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
