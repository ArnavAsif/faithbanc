{% schema %}
{
  "name": "Processor Funnel",
  "tag": "section",
  "class": "section-processor-funnel",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Four-Step Funnel"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "From <span>application</span> to monthly residuals."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Item",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Apply"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Submit your processor partner application."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Processor Funnel",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "Apply",
            "description": "Submit your processor partner application and tell us whether you are a church, nonprofit, business network, affiliate, influencer, or community organization."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "Invite",
            "description": "Share your FaithBanc™ referral link with churches, businesses, ministries, and organizations."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "Convert",
            "description": "FaithBanc™ reviews processing statements, compares savings, and helps qualified organizations switch."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "title": "Earn",
            "description": "Track approved accounts, $20 monthly partner income, volume-based participation, and activity inside the portal."
          }
        }
      ]
    }
  ]
}
{% endschema %}

