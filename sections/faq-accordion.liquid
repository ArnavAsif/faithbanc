<script>
  (function() {
    function initAccordion() {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var accordion = section.querySelector('.e-n-accordion');
      if (!accordion) return;
      var detailsList = accordion.querySelectorAll('details.e-n-accordion-item');
      
      detailsList.forEach(function(targetDetail) {
        targetDetail.addEventListener('click', function(e) {
          var summary = targetDetail.querySelector('summary');
          if (e.target === summary || summary.contains(e.target)) {
            setTimeout(function() {
              if (targetDetail.open) {
                detailsList.forEach(function(other) {
                  if (other !== targetDetail && other.open) {
                    other.removeAttribute('open');
                  }
                });
              }
            }, 10);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAccordion);
    } else {
      initAccordion();
    }
  })();
</script>
