{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq-accordion",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How does FaithBanc\u2019s flat-fee membership work?",
            "answer": "Unlike legacy processors that charge confusing percentage markups, FaithBanc charges one predictable monthly membership fee plus direct interchange at cost."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is FaithBanc compatible with my existing POS hardware?",
            "answer": "Yes. FaithBanc supports all major smart terminals, POS terminals, wireless mobile readers, and virtual e-commerce gateways."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "When are daily merchant settlement funds deposited?",
            "answer": "Standard deposits arrive next business day. Merchants using the FaithBanc Global Debit Mastercard receive real-time same-day access to settlements."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What makes FaithBanc\u2019s financing solutions different?",
            "answer": "Our capital solutions are transparent, relationship-driven, and designed for business growth rather than trapping businesses in debt spirals."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I become an authorized FaithBanc processor or affiliate?",
            "answer": "You can apply through our referral portal to partner with FaithBanc and earn substantial monthly residual income from businesses in your network."
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does FaithBanc membership work?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "FaithBanc charges one transparent flat-rate membership fee plus direct interchange at cost."
        }
      ]
    }
  ]
}
{% endschema %}

