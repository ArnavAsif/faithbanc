{% schema %}
{
  "name": "Debit Card Features",
  "tag": "section",
  "class": "section-debit-card-features",
  "settings": [
    {
      "type": "image_picker",
      "id": "app_image",
      "label": "App Preview Graphic"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Feature description text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Debit Card Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Global Account",
            "description": "Fund with USD, MXN, stablecoins, or crypto depending on program availability, jurisdiction, partner support, and compliance approval."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Spend Anywhere",
            "description": "Accepted anywhere major debit cards are honored worldwide."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Move Money",
            "description": "P2P, wires, and transfers through partner banking rails."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Stablecoin & Digital Dollar Education",
            "description": "Educational guidance on safe digital asset and currency movements."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Mobile App (iOS / Android)",
            "description": "Track balances, view transaction history, lock/unlock card, manage profiles."
          }
        }
      ]
    }
  ]
}
{% endschema %}

