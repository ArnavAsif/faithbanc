{% schema %}
{
  "name": "Global Debit Card",
  "tag": "section",
  "class": "section-global-debit-card",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "About FaithBanc\u2122"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "The FaithBanc\u2122 Global Debit Card"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A worldwide debit card built on transparency, global accessibility, and immediate merchant revenue settlement."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Join Card Waitlist"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    }
  ],
  "presets": [
    {
      "name": "Global Debit Card"
    }
  ]
}
{% endschema %}

