{% schema %}
{
  "name": "FBD Platform Features",
  "tag": "section",
  "class": "section-fbd-platform-features",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Feature description text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FBD Platform Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Token Dashboard",
            "description": "Live price updates, market cap, 24-hour volume, price chart timeframes, and transaction history."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "RWA Backing & Education",
            "description": "Real-world asset tokenization education with a backing verification panel."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "KYC Onboarding",
            "description": "User account dashboard with balances, transactions, and status indicators."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Faith Wallet",
            "description": "Multi-asset wallet for fiat and digital assets where supported."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Faith Exchange",
            "description": "Custody services and crypto trading positioning where partner-supported."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Crypto-Backed Loans",
            "description": "Lending concepts that integrate fiat and digital-asset accounts where allowed."
          }
        }
      ]
    }
  ]
}
{% endschema %}

