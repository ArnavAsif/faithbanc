<div id="section-{{ section.id }}" class="elementor elementor-48 elementor-kit-9">
  <div class="elementor-element elementor-element-7d8719e e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="7d8719e" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-cc5cdbf e-con-full e-flex e-con e-child" data-id="cc5cdbf" data-element_type="container" data-e-type="container">
        {% if section.settings.badge_text != blank %}
          <div class="elementor-element elementor-element-537d33e elementor-align-center elementor-widget elementor-widget-button" data-id="537d33e" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
            <a class="elementor-button elementor-button-link elementor-size-sm" href="#">
              <span class="elementor-button-content-wrapper">
                <span class="elementor-button-text">{{ section.settings.badge_text }}</span>
              </span>
            </a>
          </div>
        {% endif %}

        <div class="elementor-element elementor-element-9ac4b01 elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading elementor-invisible" data-id="9ac4b01" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="heading.default">
          <h2 class="elementor-heading-title elementor-size-default">
            {% if section.settings.heading != blank %}
              {{ section.settings.heading }}
            {% else %}
              About <span>FaithBanc™</span>
            {% endif %}
          </h2>
        </div>

        {% if section.settings.paragraph_1 != blank %}
          <div class="elementor-element elementor-element-fc4996e elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor elementor-invisible" data-id="fc4996e" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="text-editor.default">
            {{ section.settings.paragraph_1 }}
          </div>
        {% endif %}

        {% if section.settings.paragraph_2 != blank %}
          <div class="elementor-element elementor-element-9ec86be elementor-widget__width-inherit elementor-widget-tablet__width-initial elementor-widget elementor-widget-text-editor elementor-invisible" data-id="9ec86be" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInUp"}' data-widget_type="text-editor.default">
            {{ section.settings.paragraph_2 }}
          </div>
        {% endif %}
      </div>

      <div class="elementor-element elementor-element-4afdd87 e-con-full e-flex e-con e-child" data-id="4afdd87" data-element_type="container" data-e-type="container">
        <div class="elementor-element elementor-element-a0f8d15 elementor-widget elementor-widget-image elementor-invisible" data-id="a0f8d15" data-element_type="widget" data-e-type="widget" data-settings='{"_animation":"fadeInRight"}' data-widget_type="image.default">
          {% if section.settings.image != blank %}
            <img src="{{ section.settings.image | image_url: width: 1254 }}" class="attachment-full size-full" alt="{{ section.settings.image.alt | default: 'About FaithBanc' | escape }}" loading="lazy" width="1254" height="1254">
          {% else %}
            <img src="{{ 'about-hero-wallet.webp' | asset_url }}" class="attachment-full size-full wp-image-8467" alt="About FaithBanc" loading="lazy" width="1254" height="1254">
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About - Intro",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "FaithBanc™"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About <span>FaithBanc™</span>"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First Paragraph",
      "default": "FaithBanc™ Global is designed to serve a broad and diverse spectrum of faith-based and values-aligned organizations. Our platform is built to support institutions and communities across many traditions, including Christian denominations, Islamic mosques, Jewish organizations, Hindu and Buddhist temples, new spiritual movements, humanist and non-theistic communities, and other mission-driven institutions."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second Paragraph",
      "default": "FaithBanc™ Global provides modern financial tools intended to be accessible to religious, spiritual, and values-based organizations of all backgrounds, while respecting the independence, beliefs, and governance of each institution we serve."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "About - Intro"
    }
  ]
}
{% endschema %}
