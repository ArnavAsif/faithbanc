{% schema %}
{
  "name": "Generational Solutions",
  "tag": "section",
  "class": "section-solutions-every-generation",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "OUR SOLUTIONS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Solutions for Every Generation & Community"
    }
  ],
  "presets": [
    {
      "name": "Generational Solutions",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Teen Banking",
            "button_text": "Learn More \u2192"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Islam Banking",
            "button_text": "Learn More \u2192"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Vision & Purpose of Initiative",
            "button_text": "Learn More \u2192"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "National Rollout Cost",
            "button_text": "Learn More \u2192"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "National Economic Impact",
            "button_text": "Learn More \u2192"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Church Impact Center Model",
            "button_text": "Learn More \u2192"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Initiative Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Icon/Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Teen Banking"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Early financial literacy, controlled debit access, and interactive money management."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More \u2192"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ]
}
{% endschema %}

