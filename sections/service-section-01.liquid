{% schema %}
{
  "name": "Service Hero",
  "tag": "section",
  "class": "section-service-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Personal & Family"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday <span>Finance,</span> Simplified."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Card, wallet, transfers, check cashing, taxes, credit repair, mortgages, and insurance — all under one trusted brand."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Request Account Access"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Service Hero"
    }
  ]
}
{% endschema %}

