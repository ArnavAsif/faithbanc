{% schema %}
{
  "name": "Businesses Toolkit",
  "tag": "section",
  "class": "section-businesses-toolkit",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "What's Included"
    },
    {
      "type": "url",
      "id": "badge_url",
      "label": "Badge URL"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A full merchant <span>toolkit.</span>"
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Benefit Text",
          "default": "Merchant processing with flat-fee and custom pricing options."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Businesses Toolkit",
      "blocks": [
        {
          "type": "benefit_item",
          "settings": {
            "text": "Merchant processing with flat-fee and custom pricing options."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "High-risk merchant account support for restaurants, bars, nightclubs, pawnshops, casinos/online gaming, and cannabis-related businesses where lawful and supported."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Free equipment options \u2014 terminals, mobile readers, kiosks, and handheld devices where approved."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Rewards points on every transaction \u2014 redeemable for travel, gift cards, electronics, and luxury goods where program-supported."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Business consulting for growth, operations, profitability, compliance readiness, and financial infrastructure."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Capital review for receivable loans, short-term credit lines, and strategic funding pathways."
          }
        },
        {
          "type": "benefit_item",
          "settings": {
            "text": "Business tax preparation and compliance support referrals."
          }
        }
      ]
    }
  ]
}
{% endschema %}

