{% schema %}
{
  "name": "Financial Ecosystem",
  "tag": "section",
  "class": "section-building-ecosystem",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "About Us"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Building a Financial Ecosystem for Business Growth and Community Transformation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Reinvesting economic value directly into grassroots businesses and thriving communities."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Become a Processor"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ecosystem Image"
    }
  ],
  "presets": [
    {
      "name": "Financial Ecosystem"
    }
  ]
}
{% endschema %}

