{% schema %}
{
  "name": "Vision Statement",
  "tag": "section",
  "class": "section-vision-statement",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "About Us"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Vision Statement"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A future where every business retains its revenue and elevates its local community."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Vision Image"
    }
  ],
  "presets": [
    {
      "name": "Vision Statement"
    }
  ]
}
{% endschema %}

