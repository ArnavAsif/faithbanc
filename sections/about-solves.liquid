<div id="section-{{ section.id }}" class="elementor elementor-48 elementor-kit-9">
  <div class="elementor-element elementor-element-07852c4 e-flex e-con-boxed e-con e-parent e-lazyloaded" data-id="07852c4" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic"}'>
    <div class="e-con-inner">
      <div class="elementor-element elementor-element-bfbc0cc e-con-full e-flex e-con e-child elementor-invisible" data-id="bfbc0cc" data-element_type="container" data-e-type="container" data-settings='{"background_background":"classic","_animation":"fadeInUp"}'>
        <div class="elementor-element elementor-element-0fc26be e-con-full e-flex e-con e-child" data-id="0fc26be" data-element_type="container" data-e-type="container">
          <div class="elementor-element elementor-element-1073a14 elementor-widget__width-inherit elementor-widget-tablet__width-inherit gradient-text elementor-widget elementor-widget-heading" data-id="1073a14" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
            <h2 class="elementor-heading-title elementor-size-default">{{ section.settings.heading | default: "Solves:" }}</h2>
          </div>

          <div class="elementor-element elementor-element-bdad82d e-con-full e-flex e-con e-child" data-id="bdad82d" data-element_type="container" data-e-type="container">
            <div class="elementor-element elementor-element-c1cde72 elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget-tablet__width-inherit elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="c1cde72" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
              <ul class="elementor-icon-list-items">
                {% if section.blocks.size > 0 %}
                  {% for block in section.blocks limit: 3 %}
                    <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                      <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                    </li>
                  {% endfor %}
                {% else %}
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_1 | default: "- Lack of access to capital &nbsp;" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_2 | default: "- Unemployment &nbsp;" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col1_item_3 | default: "- Workforce shortages &nbsp;" }}</span>
                  </li>
                {% endif %}
              </ul>
            </div>

            <div class="elementor-element elementor-element-e04feaa elementor-widget__width-initial elementor-widget-mobile__width-inherit elementor-widget-tablet__width-inherit elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="e04feaa" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
              <ul class="elementor-icon-list-items">
                {% if section.blocks.size > 3 %}
                  {% for block in section.blocks offset: 3 %}
                    <li class="elementor-icon-list-item" {{ block.shopify_attributes }}>
                      <span class="elementor-icon-list-text">{{ block.settings.text }}</span>
                    </li>
                  {% endfor %}
                {% else %}
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_1 | default: "- Food insecurity &nbsp;" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_2 | default: "- Homelessness &nbsp;" }}</span>
                  </li>
                  <li class="elementor-icon-list-item">
                    <span class="elementor-icon-list-text">{{ section.settings.col2_item_3 | default: "- Financial exclusion &nbsp;" }}</span>
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        </div>

        <div class="elementor-element elementor-element-209bc82 e-con-full e-flex e-con e-child" data-id="209bc82" data-element_type="container" data-e-type="container">
          <div class="elementor-element elementor-element-1109363 elementor-widget elementor-widget-image" data-id="1109363" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
            {% if section.settings.image != blank %}
              <img src="{{ section.settings.image | image_url: width: 1024 }}" class="attachment-full size-full" alt="{{ section.settings.image.alt | default: 'Solves' | escape }}" loading="lazy" width="1024" height="1024">
            {% else %}
              <img src="{{ 'about-solves-challenges.webp' | asset_url }}" class="attachment-full size-full wp-image-8704" alt="Solves" loading="lazy" width="1024" height="1024">
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About - Solves",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Solves:"
    },
    {
      "type": "text",
      "id": "col1_item_1",
      "label": "Column 1 - Item 1",
      "default": "- Lack of access to capital &nbsp;"
    },
    {
      "type": "text",
      "id": "col1_item_2",
      "label": "Column 1 - Item 2",
      "default": "- Unemployment &nbsp;"
    },
    {
      "type": "text",
      "id": "col1_item_3",
      "label": "Column 1 - Item 3",
      "default": "- Workforce shortages &nbsp;"
    },
    {
      "type": "text",
      "id": "col2_item_1",
      "label": "Column 2 - Item 1",
      "default": "- Food insecurity &nbsp;"
    },
    {
      "type": "text",
      "id": "col2_item_2",
      "label": "Column 2 - Item 2",
      "default": "- Homelessness &nbsp;"
    },
    {
      "type": "text",
      "id": "col2_item_3",
      "label": "Column 2 - Item 3",
      "default": "- Financial exclusion &nbsp;"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section Image"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bullet Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "- Item description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About - Solves"
    }
  ]
}
{% endschema %}
